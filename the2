#!/bin/sh
# rate-hop.sh -- nft deterministic-but-VARYING cadence. Hops the keep-ratio
# (1/2 .. 5/5) periodically or randomly. nft numgen underneath (NOT netem).
# v2 FIX: busybox sleep has no fractional seconds -> use usleep (microseconds).
#
# TEST FRAME: judge by REPRODUCIBLE contest outcomes across many games, not feel.
# Timescale floor: packets ~33ms apart; intervals below 33ms are clamped.
#
# Touches ONLY 192.168.10.50:3659 outbound. Ends clean. Reversible.
#
# Usage:
#   sh rate-hop.sh periodic [ms]   # hop 1/2..5/5 in order every [ms] (default 200)
#   sh rate-hop.sh random   [ms]   # hop to a random rung every [ms]
#   sh rate-hop.sh off

HOST="192.168.10.50"; GAMEPORT="3659"; TABLE="gamehop"
RUNGS="1/2 2/3 3/4 4/5 5/5"
MINMS=33

cleanup(){ nft delete table inet "$TABLE" 2>/dev/null; }
trap 'echo; echo "hop stopped -> full 30Hz"; cleanup; exit 0' INT TERM

# portable sub-second sleep: prefer usleep (busybox microseconds); fallback to sleep
naptime(){   # arg: milliseconds
    _ms="$1"
    if command -v usleep >/dev/null 2>&1; then
        usleep $(( _ms * 1000 ))
    else
        # last resort: whole-second sleep, min 1s (avoids fractional-sleep crash)
        _s=$(( _ms / 1000 )); [ "$_s" -lt 1 ] && _s=1; sleep "$_s"
    fi
}

set_pattern(){
    KEEP="${1%/*}"; OF="${1#*/}"
    nft delete table inet "$TABLE" 2>/dev/null
    nft add table inet "$TABLE" 2>/dev/null || return 1
    nft "add chain inet $TABLE post { type filter hook postrouting priority mangle ; policy accept ; }" 2>/dev/null || return 1
    [ "$KEEP" != "$OF" ] && nft add rule inet "$TABLE" post ip saddr "$HOST" udp sport "$GAMEPORT" \
        numgen inc mod "$OF" ">=" "$KEEP" counter drop 2>/dev/null
    return 0
}

MS="${2:-200}"
[ "$MS" -lt "$MINMS" ] && { echo "clamping ${MS}ms -> ${MINMS}ms (packet floor)"; MS="$MINMS"; }

case "$1" in
    off|remove ) cleanup; echo "OFF -> full 30Hz."; exit 0 ;;
    periodic )
        echo "PERIODIC hop 1/2..5/5 every ${MS}ms. TEST by outcomes. Ctrl-C to revert." >&2
        while true; do for P in $RUNGS; do set_pattern "$P" || { cleanup; exit 1; }; naptime "$MS"; done; done ;;
    random )
        echo "RANDOM hop every ${MS}ms. TEST by outcomes, not feel. Ctrl-C to revert." >&2
        set -- $RUNGS; N=$#
        while true; do
            R=$(awk -v n="$N" 'BEGIN{srand(); print int(rand()*n)+1}')
            P=$(eval echo \${$R}); set_pattern "$P" || { cleanup; exit 1; }; naptime "$MS"
        done ;;
    * ) echo "usage: sh rate-hop.sh [periodic [ms] | random [ms] | off]"; exit 1 ;;
esac
