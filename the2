#!/bin/sh
# flow-fusion.sh -- run the isolate+fuse connection-state estimator.
# Isolates each game flow (server + peers), measures each INDEPENDENTLY, fuses,
# acts ONLY when independent sources AGREE. Passive sampling (no added latency).
#
#   sh flow-fusion.sh monitor   # READ-ONLY: watch the fused agreement signal
#   sh flow-fusion.sh act        # enable invariant-preserving re-marking on agreement
#   sh flow-fusion.sh off        # remove any marking table

HOST="192.168.10.50"; DIR="$(dirname "$0")"

# ensure conntrack tool exists (for passive per-flow sampling)
have_ct(){ command -v conntrack >/dev/null 2>&1 || [ -r /proc/net/nf_conntrack ]; }

case "$1" in
    monitor )
        have_ct || { echo "need conntrack or /proc/net/nf_conntrack"; exit 1; }
        echo "MONITOR: watching independent flows for AGREEMENT. Ctrl-C to stop." >&2
        FF_HOST="$HOST" FF_MODE="monitor" python3 "$DIR/flow-fusion.py" ;;
    act )
        have_ct || { echo "need conntrack or /proc/net/nf_conntrack"; exit 1; }
        echo "ACT: will re-mark on independent-flow agreement. Ctrl-C stops & cleans." >&2
        trap 'nft delete table ip gamefusion 2>/dev/null; exit 0' INT TERM
        FF_HOST="$HOST" FF_MODE="act" python3 "$DIR/flow-fusion.py" ;;
    off )
        nft delete table ip gamefusion 2>/dev/null && echo "removed." || echo "(not active)" ;;
    * ) echo "usage: sh flow-fusion.sh [monitor|act|off]" ;;
esac
