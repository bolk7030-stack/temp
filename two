#!/bin/sh
# setup-cake.sh -- one-shot CAKE/SQM setup for OpenWrt (Protectli)
# Usage: sh setup-cake.sh <download_kbit> <upload_kbit> [rtt_ms] [wan_iface]
#   e.g. 500/50 Mbps measured -> 90%, real RTT 30ms:  sh setup-cake.sh 450000 45000 30
# Run a speedtest FIRST and pass ~90% of measured speeds. That number is the main trick.
#
# rtt_ms (optional, default 100): CAKE defaults to assuming 100ms RTT. If your real
# ping to the game/server is lower (e.g. 20-40ms), telling CAKE the true value makes
# its AQM react faster on your low-latency flow -- a real, single-parameter lever.
# Measure with:  ping -c 10 <server_or_8.8.8.8>   and pass the avg.
# Leave blank to keep CAKE's 100ms default.

set -e

DL="$1"; UL="$2"; RTT="${3:-100}"; WAN="${4:-wan}"

if [ -z "$DL" ] || [ -z "$UL" ]; then
    echo "Usage: sh setup-cake.sh <download_kbit> <upload_kbit> [rtt_ms] [wan_iface]"
    echo "Example (500/50 Mbps, 30ms RTT): sh setup-cake.sh 450000 45000 30"
    exit 1
fi

# resolve the physical device behind the logical interface
WANDEV=$(uci -q get "network.${WAN}.device" || echo "$WAN")
echo "== WAN logical: $WAN  device: $WANDEV"
echo "== Shaping: ${DL} kbit down / ${UL} kbit up  (CAKE rtt: ${RTT}ms)"

echo "== [1/5] Disabling flow offloading (bypasses CAKE if on)..."
uci -q set firewall.@defaults[0].flow_offloading='0' || true
uci -q set firewall.@defaults[0].flow_offloading_hw='0' || true
uci commit firewall
/etc/init.d/firewall reload >/dev/null 2>&1 || fw4 reload >/dev/null 2>&1 || true

echo "== [2/5] Checking for old shaper remnants (egress-smooth etc.)..."
if grep -q "egress-smooth\|tc qdisc" /etc/rc.local 2>/dev/null; then
    echo "   !! Found shaper lines in /etc/rc.local -- commenting them out:"
    grep -n "egress-smooth\|tc qdisc" /etc/rc.local
    sed -i 's/^\(.*\(egress-smooth\|tc qdisc\).*\)$/# DISABLED-BY-CAKE-SETUP: \1/' /etc/rc.local
fi
# clear any live qdisc our old scripts left on the device
tc qdisc del dev "$WANDEV" root 2>/dev/null || true

echo "== [3/5] Installing sqm-scripts + luci-app-sqm..."
apk update
apk add sqm-scripts luci-app-sqm

echo "== [4/5] Configuring SQM: cake + layer_cake (honors your DSCP marks)..."
uci -q delete sqm.@queue[0] 2>/dev/null || true
uci add sqm queue >/dev/null
uci set sqm.@queue[-1].enabled='1'
uci set sqm.@queue[-1].interface="$WANDEV"
uci set sqm.@queue[-1].download="$DL"
uci set sqm.@queue[-1].upload="$UL"
uci set sqm.@queue[-1].qdisc='cake'
uci set sqm.@queue[-1].script='layer_cake.qos'
uci set sqm.@queue[-1].linklayer='ethernet'
uci set sqm.@queue[-1].overhead='44'
uci set sqm.@queue[-1].qdisc_advanced='1'
uci set sqm.@queue[-1].qdisc_really_really_advanced='1'
uci set sqm.@queue[-1].iqdisc_opts="nat dual-dsthost rtt ${RTT}ms"
uci set sqm.@queue[-1].eqdisc_opts="nat dual-srchost rtt ${RTT}ms"
uci commit sqm

echo "== [5/5] Enabling and starting SQM..."
/etc/init.d/sqm enable
/etc/init.d/sqm restart

echo ""
echo "== Verify CAKE is live on $WANDEV:"
tc qdisc show dev "$WANDEV" | head -4
echo ""
echo "== DONE. Now run the bufferbloat test: https://www.waveform.com/tools/bufferbloat"
echo "   Target: A/A+ with flat latency under load. If achieved: closed, no further tuning."
