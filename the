#!/bin/sh
# fc-dscp.sh -- toggle EA FC gameplay DSCP marking (UDP 3659), independent of CAKE.
#   sh fc-dscp.sh on   [CS4]   # add marking (default CS4; pass CS0/EF/etc to override)
#   sh fc-dscp.sh off          # remove marking, return to best-effort
#   sh fc-dscp.sh status       # show current marking rules
#
# NOTE: this is an EXPERIMENT. Only meaningful judged by a COUNTED W/L set
# (mark ON for N matches, OFF for N, compare records) -- not by single-session feel.
# Kept separate from setup-cake.sh on purpose: your shaper is validated, this isn't.

ACTION="$1"; MARK="${2:-CS4}"; PORT="3659"

clear_rules() {
    # delete any existing FC-DSCP rules by name (idempotent)
    while uci show firewall 2>/dev/null | grep -q "name='FC-DSCP"; do
        IDX=$(uci show firewall | grep -m1 "name='FC-DSCP" | sed "s/firewall\.@rule\[\([0-9]*\)\].*/\1/")
        [ -z "$IDX" ] && break
        uci delete firewall.@rule[$IDX]
    done
}

case "$ACTION" in
  on)
    echo "== Marking EA FC (udp $PORT) as $MARK ..."
    clear_rules
    uci add firewall rule >/dev/null
    uci set firewall.@rule[-1].name='FC-DSCP-out'
    uci set firewall.@rule[-1].src='lan'
    uci set firewall.@rule[-1].proto='udp'
    uci set firewall.@rule[-1].dest_port="$PORT"
    uci set firewall.@rule[-1].set_dscp="$MARK"
    uci set firewall.@rule[-1].target='DSCP'
    uci set firewall.@rule[-1].enabled='1'
    uci add firewall rule >/dev/null
    uci set firewall.@rule[-1].name='FC-DSCP-in'
    uci set firewall.@rule[-1].src='lan'
    uci set firewall.@rule[-1].proto='udp'
    uci set firewall.@rule[-1].src_port="$PORT"
    uci set firewall.@rule[-1].set_dscp="$MARK"
    uci set firewall.@rule[-1].target='DSCP'
    uci set firewall.@rule[-1].enabled='1'
    uci commit firewall
    service firewall restart
    echo "== Applied. Verifying in nftables:"
    nft list ruleset 2>/dev/null | grep -i dscp || echo "  !! NOTHING in nft -- fw4 didn't apply it; tell me and I'll give the native nft version."
    ;;
  off)
    echo "== Removing FC DSCP marking (back to best-effort CS0)..."
    clear_rules
    uci commit firewall
    service firewall restart
    echo "== Removed. Verify (should be empty):"
    nft list ruleset 2>/dev/null | grep -i dscp || echo "  clean -- no dscp marking."
    ;;
  status)
    echo "== Current FC DSCP rules (uci):"
    uci show firewall | grep -i "FC-DSCP\|dscp" || echo "  none in uci"
    echo "== In nftables:"
    nft list ruleset 2>/dev/null | grep -i dscp || echo "  none in nft"
    ;;
  *)
    echo "Usage: sh fc-dscp.sh on [CS4|CS0|EF|...]   |   off   |   status"
    exit 1
    ;;
esac
