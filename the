#!/bin/sh
# egress-smooth.sh -- the CLEAN isolation of "flowy": even out the cadence of
# your own outbound game packets (reduce egress jitter), with the MINIMUM added
# delay possible. Nothing else -- no fold, no fusion, no reshaping, no per-flow
# isolation. Just: release your packets at a steadier pace.
#
# *** HONEST TENSION: smoothing and delay are physically coupled. Any pacer evens
#     spacing by holding early packets slightly to align them -- so "smoother"
#     costs a little "held." This uses the SMALLEST buffer that still smooths, so
#     you can feel whether the result lands on FLOWY or tips into HELD. That IS
#     the test. ***
#
# Mechanism: a token-bucket (tbf) on JUST the game flow, rate set HIGH (near line)
# so it doesn't throttle throughput, with a SMALL burst + tiny latency target --
# this evens inter-packet spacing (paces release) without meaningfully delaying.
# tbf is the lightest cadence-shaping tool; no netem, no NFQUEUE, no userspace hop.
#
# Usage:
#   sh egress-smooth.sh on            # smooth with default (gentle) settings
#   sh egress-smooth.sh on 50 1540    # custom: rate(mbit) burst(bytes)
#   sh egress-smooth.sh off
#   sh egress-smooth.sh status

WAN="eth1"; HOST="192.168.10.50"; GP="3659"
RATE_DEFAULT="90mbit"    # high -- near line speed, so throughput isn't throttled
BURST_DEFAULT="1600"     # ~1 packet; small burst = tighter pacing (smoother)
LAT_DEFAULT="2ms"        # tiny latency target -- minimum hold to even spacing

cleanup(){ tc qdisc del dev "$WAN" root 2>/dev/null; nft delete table inet esmooth 2>/dev/null; }
trap 'echo; echo "egress-smooth OFF -> restored"; cleanup; exit 0' INT TERM

apply(){
    RATE="$1"; BURST="$2"; LAT="$3"
    cleanup
    # prio root: game flow -> band 1:1 (tbf-paced), everything else -> 1:2 (clean)
    tc qdisc add dev "$WAN" root handle 1: prio bands 3 || return 1
    # tbf on the game band: high rate (no throttle) + small burst + tiny latency
    # = evens packet spacing (paces) with minimal delay
    tc qdisc add dev "$WAN" parent 1:1 handle 10: tbf \
        rate "$RATE" burst "$BURST" latency "$LAT" 2>/dev/null || {
        echo "tbf unavailable on this build"; cleanup; return 1; }
    tc qdisc add dev "$WAN" parent 1:2 handle 20: pfifo 2>/dev/null
    tc qdisc add dev "$WAN" parent 1:3 handle 30: pfifo 2>/dev/null
    # send ONLY game egress to the paced band
    tc filter add dev "$WAN" parent 1: protocol ip prio 1 u32 \
        match ip src "${HOST}/32" match ip sport "$GP" 0xffff flowid 1:1 2>/dev/null
    echo "EGRESS-SMOOTH ON: game flow paced at rate=$RATE burst=$BURST latency=$LAT"
    echo "  Evens your outbound cadence (smoother) with minimal hold."
    echo "  FEEL TEST: is it FLOWY (smoother helps) or HELD (the hold dominates)?"
    echo "  Tighten burst (smaller=smoother,more hold) or raise it (looser,less hold)."
}

case "$1" in
    on )
        apply "${2:-$RATE_DEFAULT}" "${3:-$BURST_DEFAULT}" "${4:-$LAT_DEFAULT}" || exit 1
        echo; echo "compare on vs off by FEEL. Revert: sh egress-smooth.sh off" ;;
    status )
        tc -s qdisc show dev "$WAN" 2>/dev/null || echo "(nothing)" ;;
    off )
        cleanup; echo "OFF -> restored." ;;
    * ) echo "usage: sh egress-smooth.sh [on [rate burst latency] | status | off]" ;;
esac
