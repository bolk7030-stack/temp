#!/bin/sh
# rate-knob.sh -- EXPERIMENTAL deterministic send-rate divider for the game flow.
# Drops a DETERMINISTIC pattern of outbound game packets (NOT random/netem) to
# lower the effective send rate. For experimentation only -- feeling whether an
# off-standard cadence changes contest feel.
#
# HONEST MECHANICS (you asked):
#   - Pure selective DROP via nftables, deterministic (counter % N), evenly placed
#     where the divisor is clean.
#   - DOWN only. Cannot raise rate (information wall). Never alters/fabricates.
#   - Clean even rates = integer divisors of 30: keep 1/2 ->15Hz, 1/3 ->10Hz, 1/5 ->6Hz.
#   - "In-between" (25,24,etc) = 30Hz-with-periodic-gaps (uneven), not smooth.
#   - COST: every dropped packet is a movement update the server must extrapolate
#     through -> you trade representation freshness for the rate change.
#
# Touches ONLY console game UDP (192.168.10.50:3659) outbound. Reverts cleanly.
# This is NOT persistent -- experiment, toggle, revert. No hotplug install.
#
# Usage:
#   sh rate-knob.sh 15        # ~15Hz: drop every 2nd packet (clean, even)
#   sh rate-knob.sh 10        # ~10Hz: keep 1 of 3 (clean, even)
#   sh rate-knob.sh 25        # ~25Hz: keep 5 of 6 (GAPPY -- 30Hz with holes)
#   sh rate-knob.sh keep N M  # general: keep N of every M packets
#   sh rate-knob.sh off       # remove, back to full 30Hz
#   sh rate-knob.sh status    # show active drop pattern + live counters

HOST="192.168.10.50"
GAMEPORT="3659"
TABLE="gamerate"

# map a requested Hz to a keep/of pattern over the ~30Hz base
hz_to_pattern() {
    case "$1" in
        15) KEEP=1; OF=2 ;;     # clean
        10) KEEP=1; OF=3 ;;     # clean
        6)  KEEP=1; OF=5 ;;     # clean
        20) KEEP=2; OF=3 ;;     # gappy
        25) KEEP=5; OF=6 ;;     # gappy
        24) KEEP=4; OF=5 ;;     # gappy
        18) KEEP=3; OF=5 ;;     # gappy
        12) KEEP=2; OF=5 ;;     # clean-ish
        *)  return 1 ;;
    esac
    return 0
}

apply_pattern() {
    KEEP="$1"; OF="$2"
    # drop when (counter % OF) >= KEEP  -> keeps KEEP out of every OF packets
    nft delete table inet "$TABLE" 2>/dev/null
    nft add table inet "$TABLE" || { echo "nft add table failed"; return 1; }
    nft "add chain inet $TABLE post { type filter hook postrouting priority mangle ; policy accept ; }" || return 1
    # use numgen inc (deterministic incrementing counter) modulo OF; drop high residues
    # keep residues 0..KEEP-1, drop KEEP..OF-1
    nft add rule inet "$TABLE" post ip saddr "$HOST" udp sport "$GAMEPORT" \
        numgen inc mod "$OF" ">=" "$KEEP" counter drop 2>/dev/null \
        || { echo "numgen rule failed (kernel/nft too old for numgen?)"; return 1; }
    # a counter on the kept ones too, for status visibility
    nft add rule inet "$TABLE" post ip saddr "$HOST" udp sport "$GAMEPORT" counter 2>/dev/null
    EFF=$(awk -v k="$KEEP" -v o="$OF" 'BEGIN{printf "%.1f", 30.0*k/o}')
    echo "APPLIED: keep $KEEP of every $OF outbound game packets -> ~${EFF}Hz effective"
    case "$KEEP/$OF" in
        1/2|1/3|1/5) echo "  (clean even spacing)";;
        *) echo "  (GAPPY: 30Hz with periodic holes, not smooth -- as discussed)";;
    esac
    echo "  cost: dropped packets = movement updates server must extrapolate through."
}

case "$1" in
    off|remove )
        nft delete table inet "$TABLE" 2>/dev/null && echo "rate-knob OFF -> full 30Hz restored." || echo "(not active)"
        ;;
    status )
        if nft list table inet "$TABLE" >/dev/null 2>&1; then
            echo "ACTIVE:"; nft list table inet "$TABLE" 2>/dev/null | grep -E 'numgen|counter' | sed 's/^/   /'
        else echo "rate-knob not active (full 30Hz)."; fi
        ;;
    keep )
        # general: sh rate-knob.sh keep N M
        [ -n "$2" ] && [ -n "$3" ] || { echo "usage: sh rate-knob.sh keep N M"; exit 1; }
        apply_pattern "$2" "$3"
        ;;
    "" )
        echo "usage: sh rate-knob.sh [15|10|25|...|keep N M|off|status]"
        echo "clean: 15 10 6 | gappy: 25 24 20 18 12 | general: keep N M"
        ;;
    * )
        if hz_to_pattern "$1"; then apply_pattern "$KEEP" "$OF"
        else echo "no preset for ${1}Hz. use: sh rate-knob.sh keep N M  (keep N of every M)"; exit 1; fi
        ;;
esac

if [ "$1" != "off" ] && [ "$1" != "status" ] && [ -n "$1" ]; then
    echo
    echo "EXPERIMENT, not optimization. Judge by FEEL + reproducibility across games."
    echo "Prior: likely neutral-to-slightly-negative (freshness cost). Revert: sh rate-knob.sh off"
fi
