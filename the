#!/bin/sh
# phase-pacer.sh -- wire game flow into NFQUEUE using iptables, then run pacer.

HOST="192.168.10.50"; GP="3659"; QNUM=0
DIR="$(dirname "$0")"

wire(){
    iptables -t mangle -D POSTROUTING -s "$HOST" -p udp --dport "$GP" -j NFQUEUE --queue-num "$QNUM" 2>/dev/null
    iptables -t mangle -D PREROUTING  -d "$HOST" -p udp --sport "$GP" -j NFQUEUE --queue-num "$QNUM" 2>/dev/null

    iptables -t mangle -A POSTROUTING -s "$HOST" -p udp --dport "$GP" -j NFQUEUE --queue-num "$QNUM" || return 1
    iptables -t mangle -A PREROUTING  -d "$HOST" -p udp --sport "$GP" -j NFQUEUE --queue-num "$QNUM" || return 1
    return 0
}

teardown(){
    iptables -t mangle -D POSTROUTING -s "$HOST" -p udp --dport "$GP" -j NFQUEUE --queue-num "$QNUM" 2>/dev/null
    iptables -t mangle -D PREROUTING  -d "$HOST" -p udp --sport "$GP" -j NFQUEUE --queue-num "$QNUM" 2>/dev/null
}

case "$1" in
    on )
        modprobe nfnetlink_queue 2>/dev/null
        modprobe xt_NFQUEUE 2>/dev/null

        command -v python3 >/dev/null 2>&1 || {
            echo "ERROR: python3 not found"
            exit 1
        }

        NFQ_LIB=""
        for L in \
            /usr/lib/libnetfilter_queue.so.1 \
            /usr/lib/libnetfilter_queue.so.1.5.0 \
            libnetfilter_queue.so.1
        do
            python3 -c "import ctypes; ctypes.CDLL('$L')" 2>/tmp/nfq-load.err && {
                NFQ_LIB="$L"
                break
            }
        done

        [ -n "$NFQ_LIB" ] || {
            echo "ERROR: can't load libnetfilter_queue"
            cat /tmp/nfq-load.err
            exit 1
        }

        wire || {
            echo "iptables NFQUEUE wiring failed"
            teardown
            exit 1
        }

        echo "wired game flow via iptables -> NFQUEUE $QNUM"
        echo "using NFQ lib: $NFQ_LIB"
        echo "Ctrl-C to stop & tear down."

        trap 'teardown; echo; echo "torn down."; exit 0' INT TERM

        PHASE_HOST="$HOST" \
        PHASE_PORT="$GP" \
        PHASE_QNUM="$QNUM" \
        PHASE_NFQ_LIB="$NFQ_LIB" \
        python3 "$DIR/phase-pacer-ctypes.py"

        teardown
        ;;

    off )
        teardown
        echo "torn down."
        ;;

    * )
        echo "usage: sh phase-pacer.sh [on|off]"
        ;;
esac