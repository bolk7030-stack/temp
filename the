#!/usr/bin/env python3
# flow-fusion.py v3 -- DISCRETE agreement (robust) + v2's game-flow FILTER.
#
# Takes what each version got right:
#  - v1: discrete agreement count -> robust to dirty/outlier flow magnitudes
#        (a garbage flow casts at most ONE vote; it can't drag a weighted mean).
#  - v2: game-flow filter -> not drowning in ~150 conntrack entries.
#
# Each REAL game flow independently votes degraded/not (binary, robust). Action
# fires only when >=AGREE independent game flows AGREE. Agreement of independent
# sources = real event; lone spikes = that path's noise, ignored.
#
# Action is invariant-preserving (DSCP re-mark). monitor mode = read-only.
# Env: FF_HOST, FF_MODE(monitor|act), FF_WIN, FF_AGREE, FF_MINBYTES, FF_SENS

import os, time, subprocess, collections, sys, re

HOST     = os.environ.get("FF_HOST", "192.168.10.50")
MODE     = os.environ.get("FF_MODE", "monitor")
WIN      = float(os.environ.get("FF_WIN", "2.0"))
AGREE    = int(os.environ.get("FF_AGREE", "2"))      # independent flows needed
MINBYTES = int(os.environ.get("FF_MINBYTES", "1"))   # "moved >0 bytes" floor (latency-tolerant)
PERSIST  = int(os.environ.get("FF_PERSIST", "4"))    # windows a flow must persist to qualify
SENS     = float(os.environ.get("FF_SENS", "1.5"))   # degraded = jitter > SENS*baseline
TABLE    = "gamefusion"

class FlowSensor:
    def __init__(s, key):
        s.key=key; s.last=None
        s.iv=collections.deque(maxlen=30)
        s.base=None
        s.moved_windows=0   # windows where flow moved >=MINBYTES (any movement)
        s.seen_windows=0    # windows where flow was present at all
    def update(s, bytecount):
        s.seen_windows+=1
        if s.last is not None:
            d=bytecount-s.last
            if d>=0: s.iv.append(d)
            if d>=MINBYTES: s.moved_windows+=1   # latency-tolerant: ANY movement counts
        s.last=bytecount
    def is_game(s):
        # qualify by PERSISTENCE (keeps appearing & moving at all), NOT byte
        # volume per window -- so a high-latency flow that trickles fewer bytes
        # per window still qualifies instead of being starved out of the fusion.
        return s.moved_windows>=PERSIST and len(s.iv)>=4
    def jitter(s):
        if len(s.iv)<4: return None
        m=sum(s.iv)/len(s.iv)
        if m<=0: return None
        var=sum((x-m)**2 for x in s.iv)/len(s.iv)
        return (var**0.5)/m
    def degraded(s):
        # DISCRETE vote: True/False/None. Robust -- magnitude not trusted, just
        # "is this flow clearly above its OWN baseline."
        j=s.jitter()
        if j is None: return None
        if s.base is None:
            s.base=j; return False
        s.base=0.98*s.base+0.02*j
        if s.base<=0: return False
        return j > SENS*s.base

def sample_flows():
    flows={}; out=""
    try:
        out=subprocess.run(["conntrack","-L","-p","udp"],capture_output=True,
                           text=True,timeout=2).stdout
    except Exception:
        try: out=open("/proc/net/nf_conntrack").read()
        except Exception: return flows
    for line in out.splitlines():
        if HOST not in line or "udp" not in line: continue
        ips=re.findall(r'(\d+\.\d+\.\d+\.\d+)',line)
        byts=re.findall(r'bytes=(\d+)',line)
        remote=None
        for ip in ips:
            if ip!=HOST and not ip.startswith("192.168.") and ip!="255.255.255.255":
                remote=ip; break
        if remote:
            tot=sum(int(x) for x in byts) if byts else 0
            flows[remote]=flows.get(remote,0)+tot
    return flows

def mark():
    subprocess.run(["nft","delete","table","ip",TABLE],stderr=subprocess.DEVNULL)
    rules=(f"table ip {TABLE} {{ chain post {{ "
           f"type filter hook postrouting priority 0; policy accept; "
           f"ip saddr {HOST} udp ip dscp set ef counter; "
           f"ip daddr {HOST} udp ip dscp set ef counter; }} }}")
    subprocess.run(["nft","-f","-"],input=rules,text=True,stderr=subprocess.DEVNULL)
def unmark():
    subprocess.run(["nft","delete","table","ip",TABLE],stderr=subprocess.DEVNULL)

def main():
    sensors={}; state="clean"
    sys.stderr.write(f"flow-fusion v3: HOST={HOST} MODE={MODE} "
                     f"need {AGREE} independent game-flows to AGREE degraded "
                     f"(discrete+persistence-filter, latency-tolerant)\n")
    if MODE=="act": mark()
    try:
        while True:
            flows=sample_flows()
            for k,b in flows.items():
                sensors.setdefault(k,FlowSensor(k)).update(b)
            # consider ONLY real game flows; each casts a discrete vote
            votes={k:s.degraded() for k,s in sensors.items() if s.is_game()}
            ready={k:v for k,v in votes.items() if v is not None}
            deg=sum(1 for v in ready.values() if v)
            ng=len(ready)
            agreed = deg>=AGREE
            trans=""
            if state=="clean" and agreed:
                state="degraded"
                if MODE=="act": mark(); trans="  >> AGREEMENT degraded -> re-marked"
                else: trans="  >> AGREEMENT degraded"
            elif state=="degraded" and not agreed:
                state="clean"
                if MODE=="act": mark(); trans="  >> cleared -> reverted"
                else: trans="  >> cleared"
            seen_total=len(sensors)
            sys.stderr.write(f"[fusion] seen={seen_total} game-flows={ng} degraded={deg} "
                             f"agreed={agreed} state={state} votes={ready}\n")
            if trans: sys.stderr.write(trans+"\n")
            sys.stderr.flush()
            time.sleep(WIN)
    except KeyboardInterrupt:
        pass
    finally:
        if MODE=="act": unmark()
        sys.stderr.write("\nflow-fusion stopped.\n")

if __name__=="__main__":
    main()
