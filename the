#!/usr/bin/env python3
# flow-fusion.py v1.1 -- v1 (no game-filter, correct for a box that ONLY carries
# game traffic) + two minimal, honest improvements:
#   (1) LIVENESS guard: a flow only votes if it's still actually moving bytes,
#       so stale/dead conntrack entries don't pollute the agreement count.
#       This is NOT the v3 game-filter (which wrongly discarded real game flows
#       on a single-purpose box) -- it only drops DEAD flows, keeps every live one.
#   (2) Tunable baseline-rate + threshold (the knobs that actually matter in v1).
#
# All flows on this Protectli are your game/EA/peer traffic, so we fuse ALL live
# flows -- that's the full set of independent sources, exactly what fusion wants.
#
# Env: FF_HOST, FF_MODE(monitor|act), FF_WIN, FF_AGREE, FF_BASE, FF_SENS, FF_STALE

import os, time, subprocess, collections, sys, re

HOST   = os.environ.get("FF_HOST", "192.168.10.50")
MODE   = os.environ.get("FF_MODE", "monitor")
WIN    = float(os.environ.get("FF_WIN", "2.0"))
AGREE  = int(os.environ.get("FF_AGREE", "2"))
# the two knobs that matter in v1:
BASE   = float(os.environ.get("FF_BASE", "0.02"))  # baseline adapt rate (higher=faster forget)
SENS   = float(os.environ.get("FF_SENS", "1.5"))   # degraded = jitter > SENS*baseline
# liveness: a flow must have moved bytes within this many windows to still vote
STALE  = int(os.environ.get("FF_STALE", "2"))
TABLE  = "gamefusion"

class FlowSensor:
    def __init__(s, key):
        s.key=key; s.last_bytes=None
        s.iv=collections.deque(maxlen=30)
        s.base_jit=None
        s.idle_windows=0            # consecutive windows with no byte movement
    def update(s, bytecount):
        if s.last_bytes is not None:
            d=bytecount-s.last_bytes
            if d>0:
                s.iv.append(d); s.idle_windows=0
            else:
                s.idle_windows+=1   # no movement this window
        s.last_bytes=bytecount
    def live(s):
        # still an active flow (not a stale conntrack leftover)
        return s.idle_windows < STALE
    def jitter(s):
        if len(s.iv)<8: return None
        m=sum(s.iv)/len(s.iv)
        if m<=0: return None
        var=sum((x-m)**2 for x in s.iv)/len(s.iv)
        return (var**0.5)/m
    def degraded(s):
        j=s.jitter()
        if j is None: return None
        if s.base_jit is None:
            s.base_jit=j; return False
        s.base_jit=(1.0-BASE)*s.base_jit + BASE*j   # tunable adapt rate
        return j > SENS*s.base_jit

def sample_flows():
    flows={}
    try:
        out=subprocess.run(["conntrack","-L","-p","udp"],capture_output=True,
                           text=True,timeout=2).stdout
    except Exception:
        try: out=open("/proc/net/nf_conntrack").read()
        except Exception: return flows
    for line in out.splitlines():
        if HOST not in line: continue
        m=re.findall(r'(\d+\.\d+\.\d+\.\d+)',line)
        b=re.findall(r'bytes=(\d+)',line)
        remote=None
        for ip in m:
            if ip!=HOST: remote=ip; break
        if remote:
            tot=sum(int(x) for x in b) if b else 0
            flows[remote]=flows.get(remote,0)+tot
    return flows

def mark(_p=None):
    subprocess.run(["nft","delete","table","ip",TABLE],stderr=subprocess.DEVNULL)
    rules=(f"table ip {TABLE} {{ chain post {{ "
           f"type filter hook postrouting priority 0; policy accept; "
           f"ip saddr {HOST} udp ip dscp set ef counter; "
           f"ip daddr {HOST} udp ip dscp set ef counter; }} }}")
    subprocess.run(["nft","-f","-"],input=rules,text=True,stderr=subprocess.DEVNULL)
def unmark():
    subprocess.run(["nft","delete","table","ip",TABLE],stderr=subprocess.DEVNULL)

def main():
    sensors={}; state="clean"
    sys.stderr.write(f"flow-fusion v1.1: HOST={HOST} MODE={MODE} AGREE={AGREE} "
                     f"BASE={BASE} SENS={SENS} (all live flows, no game-filter)\n")
    if MODE=="act": mark()
    try:
        while True:
            flows=sample_flows()
            for k,b in flows.items():
                sensors.setdefault(k,FlowSensor(k)).update(b)
            # vote: ALL LIVE flows (liveness guard only -- no game-filtering)
            verdicts={k:s.degraded() for k,s in sensors.items() if s.live()}
            ready={k:v for k,v in verdicts.items() if v is not None}
            deg=sum(1 for v in ready.values() if v)
            total=len(ready)
            agreed=deg>=AGREE
            live_n=sum(1 for s in sensors.values() if s.live())
            trans=""
            if agreed and state=="clean":
                state="degraded"
                if MODE=="act": mark(); trans="  >> AGREEMENT degraded -> re-marked"
                else: trans="  >> AGREEMENT degraded"
            elif not agreed and state=="degraded":
                state="clean"
                if MODE=="act": mark(); trans="  >> cleared -> reverted"
                else: trans="  >> cleared"
            jits={k:(round(s.jitter(),3) if s.jitter() else None)
                  for k,s in sensors.items() if s.live()}
            sys.stderr.write(f"[fusion] live={live_n} voting={total} degraded={deg} "
                             f"agreed={agreed} state={state} jit={jits}\n")
            if trans: sys.stderr.write(trans+"\n")
            sys.stderr.flush()
            time.sleep(WIN)
    except KeyboardInterrupt:
        pass
    finally:
        if MODE=="act": unmark()
        sys.stderr.write("\nflow-fusion stopped.\n")

if __name__=="__main__":
    main()
