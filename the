#!/bin/sh
# phase-pacer.sh -- wire game flow into NFQUEUE and run the ctypes pacer.

HOST="192.168.10.50"; GP="3659"; QNUM=0; TABLE="phasepacer"
DIR="$(dirname "$0")"

wire(){
    nft delete table ip "$TABLE" 2>/dev/null
    nft add table ip "$TABLE" || return 1

    nft "add chain ip $TABLE post { type filter hook postrouting priority 0 ; policy accept ; }" || return 1
    nft "add chain ip $TABLE fwd  { type filter hook forward     priority 0 ; policy accept ; }" || return 1

    # outbound console -> server
    nft add rule ip "$TABLE" post ip saddr "$HOST" udp sport "$GP" counter queue num "$QNUM" || return 1

    # inbound server -> console, after routing/NAT decision
    nft add rule ip "$TABLE" fwd ip daddr "$HOST" udp dport "$GP" counter queue num "$QNUM" || return 1

    return 0
}

case "$1" in
    on )
        modprobe nfnetlink_queue 2>/dev/null
        modprobe nft_queue 2>/dev/null

        python3 -c "import ctypes; ctypes.CDLL('/usr/lib/libnetfilter_queue.so.1')" 2>/dev/null \
            || { echo "ERROR: can't load libnetfilter_queue.so.1"; exit 1; }

        wire || {
            echo "nft wiring failed"
            nft delete table ip "$TABLE" 2>/dev/null
            exit 1
        }

        echo "wired IPv4 game flow (out postrouting, in forward) -> NFQUEUE $QNUM. Launching ctypes pacer." >&2
        echo "Ctrl-C to stop & tear down. WATCH the lock= value." >&2

        trap 'nft delete table ip "$TABLE" 2>/dev/null; echo; echo "torn down."; exit 0' INT TERM

        PHASE_HOST="$HOST" PHASE_PORT="$GP" PHASE_QNUM="$QNUM" python3 "$DIR/phase-pacer-ctypes.py"

        nft delete table ip "$TABLE" 2>/dev/null
        ;;

    off )
        nft delete table ip "$TABLE" 2>/dev/null && echo "torn down." || echo "(not active)"
        ;;

    * )
        echo "usage: sh phase-pacer.sh [on|off]"
        ;;
esac