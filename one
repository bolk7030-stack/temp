#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

TARGET_DELAY_MS=12

# Shared pressure field
PRESSURE_DEBT=0
LAST_PRESSURE_DEBT=0
PRESSURE_DEBT_MAX=60
PRESSURE_DECAY_PER_TICK=2

# Main authority
UP_TRIM_PER_DEBT=450
DOWN_TRIM_PER_DEBT=700

# Rebound controller:
# converts pressure release into targeted re-centering
REBOUND_GAIN=2
REBOUND_MAX=10
REBOUND_DECAY_PER_TICK=2
REBOUND=0

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY wan=${WAN_DELAY}ms ifb=${IFB_DELAY}ms field_excess=$FIELD_EXCESS debt=$PRESSURE_DEBT rebound=$REBOUND control=$CONTROL_DEBT game=${GAME_UP}/${GAME_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    WAN_EXCESS=$((WAN_DELAY - TARGET_DELAY_MS))
    IFB_EXCESS=$((IFB_DELAY - TARGET_DELAY_MS))

    [ "$WAN_EXCESS" -lt 0 ] && WAN_EXCESS=0
    [ "$IFB_EXCESS" -lt 0 ] && IFB_EXCESS=0

    if [ "$WAN_EXCESS" -gt "$IFB_EXCESS" ]; then
        MAX_EXCESS="$WAN_EXCESS"
        MIN_EXCESS="$IFB_EXCESS"
        SIDE="wan"
    else
        MAX_EXCESS="$IFB_EXCESS"
        MIN_EXCESS="$WAN_EXCESS"
        SIDE="ifb"
    fi

    # Shared-field translator:
    # both sides pressured = full obligation
    # one side pressured = partial obligation
    if [ "$MAX_EXCESS" -gt 0 ]; then
        if [ "$MIN_EXCESS" -gt 0 ]; then
            FIELD_EXCESS="$MAX_EXCESS"
        else
            FIELD_EXCESS=$(((MAX_EXCESS + 1) / 2))
        fi

        PRESSURE_DEBT=$((PRESSURE_DEBT + FIELD_EXCESS))
    else
        FIELD_EXCESS=0
        PRESSURE_DEBT=$((PRESSURE_DEBT - PRESSURE_DECAY_PER_TICK))
    fi

    PRESSURE_DEBT="$(clamp "$PRESSURE_DEBT" 0 "$PRESSURE_DEBT_MAX")"

    # Rebound:
    # if pressure debt is falling, convert release into purposeful re-centering.
    DEBT_DROP=$((LAST_PRESSURE_DEBT - PRESSURE_DEBT))
    [ "$DEBT_DROP" -lt 0 ] && DEBT_DROP=0

    if [ "$DEBT_DROP" -gt 0 ]; then
        REBOUND=$((REBOUND + DEBT_DROP * REBOUND_GAIN))
    else
        REBOUND=$((REBOUND - REBOUND_DECAY_PER_TICK))
    fi

    REBOUND="$(clamp "$REBOUND" 0 "$REBOUND_MAX")"

    # Rebound reduces control debt temporarily,
    # creating a clean targeted return instead of only sustained drag.
    CONTROL_DEBT=$((PRESSURE_DEBT - REBOUND))
    [ "$CONTROL_DEBT" -lt 0 ] && CONTROL_DEBT=0

    NEW_UP=$((BULK_UP_BASE - CONTROL_DEBT * UP_TRIM_PER_DEBT))
    NEW_DOWN=$((BULK_DOWN_BASE - CONTROL_DEBT * DOWN_TRIM_PER_DEBT))

    CUR_BULK_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    CUR_BULK_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    apply_rates

    LAST_PRESSURE_DEBT="$PRESSURE_DEBT"

    sleep "$SLEEP_SEC"
done