#!/bin/sh
# phase-detect.sh -- Path 2, step 1: CONFIRM THE PREMISE before building a pacer.
#
# The phase-folding idea only works if a packet's DEPARTURE PHASE (where it sits
# in the remote tick cycle) predicts its RESPONSE SPEED. This script tests that
# directly, using only tcpdump (proven working) -- no NFQUEUE, no pacer yet.
#
# METHOD (data-science, not tuning):
#   1. Capture bidirectional game UDP.
#   2. For each candidate TICK PERIOD, assign every outbound packet a phase =
#      (departure_time mod period). Bin packets by phase.
#   3. For each phase bin, compute the MEAN response delay (OUT -> next IN).
#   4. If response delay varies a lot ACROSS phase bins at some period, then
#      phase predicts outcome -> folding can work, and:
#         - the period with the strongest variation = the real tick
#         - the fastest phase bin = the FOLD TARGET (where we want packets)
#      If response delay is FLAT across phases at every period -> phase does NOT
#      predict outcome -> folding is pointless. Stop, honestly.
#
# We sweep several candidate tick periods and let the DATA pick the one (if any)
# where phase matters -- that's how we detect the tick instead of assuming it.
#
# Usage: sh phase-detect.sh [packet_count]   (default 1200; more = cleaner bins)

HOST="192.168.10.50"
COUNT="${1:-1200}"
RAW="/tmp/pd-raw-$$.txt"

# candidate tick periods (ms): 120Hz,100,75,60,50,40,30Hz and 33/16.7 explicitly
PERIODS="8.333 10 13.333 16.667 20 25 33.333 50"
BINS=8

echo "Capturing $COUNT game UDP packets for $HOST ... PLAY NOW (move/contest)." >&2
tcpdump -n -tt -c "$COUNT" -i br-lan \
    host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
    2>/dev/null > "$RAW"

LINES=$(wc -l < "$RAW" 2>/dev/null)
echo "captured ${LINES:-0} packets" >&2
if [ "${LINES:-0}" -lt 100 ]; then
    echo "Too few. Need a live match with steady traffic. Aborting." >&2
    rm -f "$RAW"; exit 1
fi

awk -v HOST="$HOST" -v PERIODS="$PERIODS" -v BINS="$BINS" '
function islocal(ip){ return (ip ~ /^192\.168\./ || ip ~ /^239\./ || ip ~ /^224\./ || ip ~ /^255\./) }
{
    t=$1+0; src=$3; dst=$5; sub(/:$/,"",dst)
    split(src,sa,"."); si=sa[1]"."sa[2]"."sa[3]"."sa[4]
    split(dst,da,"."); di=da[1]"."da[2]"."da[3]"."da[4]
    if (si==HOST){dir="OUT";o=di} else if(di==HOST){dir="IN";o=si} else next
    if (islocal(o)) next
    if (dir=="OUT"){
        no++; outt[no]=t; lastout=t
    } else if (lastout>0){
        rd=(t-lastout)*1000
        if (rd>=0 && rd<200){ rc++; rtime[rc]=lastout; rdelay[rc]=rd }   # pair: this OUT -> response delay
    }
}
END{
    if (rc < 60){ print "  too few OUT->IN pairs ("rc") to analyse phase. Need more play."; exit }
    np=split(PERIODS, P, " ")
    printf "\n  analysed %d response-paired packets\n", rc
    printf "  testing %d candidate tick periods, %d phase bins each\n\n", np, BINS

    bestP=0; bestSpread=-1; bestFastBin=-1; bestFastVal=0; bestSlowVal=0
    for (p=1; p<=np; p++){
        per = P[p]+0
        # reset bins
        for (b=0;b<BINS;b++){ sum[b]=0; cnt[b]=0 }
        for (i=1;i<=rc;i++){
            tm = rtime[i]*1000.0                 # ms
            n = int(tm/per); ph = tm - n*per     # phase within tick, 0..per (manual fmod)
            b = int((ph/per)*BINS); if(b>=BINS)b=BINS-1; if(b<0)b=0
            sum[b]+=rdelay[i]; cnt[b]++
        }
        # per-bin means, find min/max bin mean = spread (how much phase matters)
        mn=1e9; mx=-1e9; fastb=-1
        valid=1
        for (b=0;b<BINS;b++){
            if (cnt[b]<3){ valid=0 }   # need enough samples per bin
            m = (cnt[b]>0)? sum[b]/cnt[b] : 0
            mean[b]=m
            if (cnt[b]>0 && m<mn){ mn=m; fastb=b }
            if (cnt[b]>0 && m>mx){ mx=m }
        }
        spread = mx-mn
        printf "  period %6.3f ms (%5.1f Hz):  response-delay spread across phase = %.2f ms", per, 1000/per, spread
        if (!valid) printf "  (sparse bins)"
        printf "\n"
        if (valid && spread>bestSpread){ bestSpread=spread; bestP=per; bestFastBin=fastb; bestFastVal=mn; bestSlowVal=mx }
    }

    print ""
    if (bestP==0){ print "  No period had well-populated bins. Capture more packets and retry."; exit }

    printf "  STRONGEST phase dependence: period %.3f ms (%.1f Hz), spread %.2f ms\n", bestP, 1000/bestP, bestSpread
    print ""
    # show the winning periods per-phase profile
    per=bestP
    for (b=0;b<BINS;b++){ sum[b]=0; cnt[b]=0 }
    for (i=1;i<=rc;i++){
        tm=rtime[i]*1000.0; n=int(tm/per); ph=tm-n*per
        b=int((ph/per)*BINS); if(b>=BINS)b=BINS-1; if(b<0)b=0
        sum[b]+=rdelay[i]; cnt[b]++
    }
    print "  per-phase response delay at this period:"
    for (b=0;b<BINS;b++){
        m=(cnt[b]>0)?sum[b]/cnt[b]:0
        bar=""; k=int(m); while(k-->0 && length(bar)<40) bar=bar"#"
        tag=""; if(b==bestFastBin) tag=" <= FAST phase (fold target)"
        printf "   phase %d/%d | %-40s %.1fms (n=%d)%s\n", b, BINS, bar, m, cnt[b], tag
    }
    print ""
    print "  READING:"
    printf "   spread = %.2f ms.\n", bestSpread
    print "   - spread LARGE (say > 8ms) and one period clearly wins -> phase PREDICTS"
    print "     outcome. Folding is justified: target the FAST phase bin above."
    print "   - spread SMALL (< ~4ms) or similar at all periods -> phase does NOT"
    print "     predict outcome. A per-packet pacer would NOT help. Stop here."
    print ""
    print "  Run this 2-3 times. A real tick reproduces the SAME winning period and"
    print "  fast phase. If the winner jumps around each run, it is noise, not a tick."
}
' "$RAW"
rm -f "$RAW"
