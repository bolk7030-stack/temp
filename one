#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"
GAME_CLASS="1:15"

SLEEP_SEC=1

BASE_GAME_UP=8500
BASE_GAME_DOWN=12000

MAX_GAME_UP=15000
MAX_GAME_DOWN=20000
MIN_GAME_UP=5000
MIN_GAME_DOWN=8000

BOOST=0
AVG_DELTA=0

FACTOR=180
BASE_PULSE=300
MAX_BOOST=3000

MEMORY_NUM=8
MEMORY_DEN=10

# Leaky-hold apply
UP_APPLY_THRESHOLD=250
DOWN_APPLY_THRESHOLD=700
DOWN_RELEASE_STEP=300

LAST_APPLIED_UP=0
LAST_APPLIED_DOWN=0

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

LAST_TOTAL=0

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))
    DELTA=$((TOTAL - LAST_TOTAL))

    AVG_DELTA=$(((AVG_DELTA * 7 + DELTA * 3) / 10))

    DEFICIT=$((AVG_DELTA - DELTA))
    [ "$DEFICIT" -lt 0 ] && DEFICIT=0

    SIGNAL=$((DEFICIT + 2))
    TARGET=$((BASE_PULSE + SIGNAL * FACTOR))

    BOOST=$(((BOOST * MEMORY_NUM + TARGET * (MEMORY_DEN - MEMORY_NUM)) / MEMORY_DEN))

    [ "$BOOST" -lt 0 ] && BOOST=0
    [ "$BOOST" -gt "$MAX_BOOST" ] && BOOST="$MAX_BOOST"

    DESIRED_UP=$((BASE_GAME_UP + BOOST))
    DESIRED_DOWN=$((BASE_GAME_DOWN + BOOST))

    [ "$DESIRED_UP" -lt "$MIN_GAME_UP" ] && DESIRED_UP="$MIN_GAME_UP"
    [ "$DESIRED_DOWN" -lt "$MIN_GAME_DOWN" ] && DESIRED_DOWN="$MIN_GAME_DOWN"

    [ "$DESIRED_UP" -gt "$MAX_GAME_UP" ] && DESIRED_UP="$MAX_GAME_UP"
    [ "$DESIRED_DOWN" -gt "$MAX_GAME_DOWN" ] && DESIRED_DOWN="$MAX_GAME_DOWN"

    if [ "$LAST_APPLIED_UP" -eq 0 ]; then
        LAST_APPLIED_UP="$DESIRED_UP"
    fi

    if [ "$LAST_APPLIED_DOWN" -eq 0 ]; then
        LAST_APPLIED_DOWN="$DESIRED_DOWN"
    fi

    APPLY_UP="$LAST_APPLIED_UP"
    APPLY_DOWN="$LAST_APPLIED_DOWN"

    # Rise fast
    if [ "$DESIRED_UP" -gt "$LAST_APPLIED_UP" ]; then
        DIFF=$((DESIRED_UP - LAST_APPLIED_UP))
        if [ "$DIFF" -ge "$UP_APPLY_THRESHOLD" ]; then
            APPLY_UP="$DESIRED_UP"
        fi
    fi

    if [ "$DESIRED_DOWN" -gt "$LAST_APPLIED_DOWN" ]; then
        DIFF=$((DESIRED_DOWN - LAST_APPLIED_DOWN))
        if [ "$DIFF" -ge "$UP_APPLY_THRESHOLD" ]; then
            APPLY_DOWN="$DESIRED_DOWN"
        fi
    fi

    # Release slow
    if [ "$DESIRED_UP" -lt "$LAST_APPLIED_UP" ]; then
        DIFF=$((LAST_APPLIED_UP - DESIRED_UP))
        if [ "$DIFF" -ge "$DOWN_APPLY_THRESHOLD" ]; then
            APPLY_UP=$((LAST_APPLIED_UP - DOWN_RELEASE_STEP))
            [ "$APPLY_UP" -lt "$DESIRED_UP" ] && APPLY_UP="$DESIRED_UP"
        fi
    fi

    if [ "$DESIRED_DOWN" -lt "$LAST_APPLIED_DOWN" ]; then
        DIFF=$((LAST_APPLIED_DOWN - DESIRED_DOWN))
        if [ "$DIFF" -ge "$DOWN_APPLY_THRESHOLD" ]; then
            APPLY_DOWN=$((LAST_APPLIED_DOWN - DOWN_RELEASE_STEP))
            [ "$APPLY_DOWN" -lt "$DESIRED_DOWN" ] && APPLY_DOWN="$DESIRED_DOWN"
        fi
    fi

    SHOULD_APPLY=0
    [ "$APPLY_UP" -ne "$LAST_APPLIED_UP" ] && SHOULD_APPLY=1
    [ "$APPLY_DOWN" -ne "$LAST_APPLIED_DOWN" ] && SHOULD_APPLY=1

    echo "delta=$DELTA avg=$AVG_DELTA deficit=$DEFICIT boost=$BOOST desired_up=$DESIRED_UP desired_down=$DESIRED_DOWN apply_up=$APPLY_UP apply_down=$APPLY_DOWN apply=$SHOULD_APPLY"

    if [ "$SHOULD_APPLY" -eq 1 ]; then
        if has_class "$WAN_DEV" "$GAME_CLASS"; then
            tc class change dev "$WAN_DEV" classid "$GAME_CLASS" \
                hfsc ls rate "${APPLY_UP}kbit" ul rate "${APPLY_UP}kbit"
        fi

        if has_class "$IFB_DEV" "$GAME_CLASS"; then
            tc class change dev "$IFB_DEV" classid "$GAME_CLASS" \
                hfsc ls rate "${APPLY_DOWN}kbit" ul rate "${APPLY_DOWN}kbit"
        fi

        LAST_APPLIED_UP="$APPLY_UP"
        LAST_APPLIED_DOWN="$APPLY_DOWN"
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
