#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

TARGET_DELAY_MS=12

# Trim strength per unit of effective pressure
UP_TRIM_PER_PRESSURE=450
DOWN_TRIM_PER_PRESSURE=700

# Long-memory sustained pressure
LONG_DEBT=0
LONG_DEBT_MAX=60
LONG_DECAY_PER_TICK=3

# Short-memory pressure density
SHORT_DEBT=0
SHORT_DEBT_MAX=30
SHORT_DECAY_PER_TICK=8

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY delay=${DELAY}ms side=$SIDE excess=$EXCESS long=$LONG_DEBT short=$SHORT_DEBT eff=$EFFECTIVE_PRESSURE game=${GAME_UP}/${GAME_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    if [ "$WAN_DELAY" -gt "$IFB_DELAY" ]; then
        DELAY="$WAN_DELAY"
        SIDE="wan"
    else
        DELAY="$IFB_DELAY"
        SIDE="ifb"
    fi

    EXCESS=$((DELAY - TARGET_DELAY_MS))

    if [ "$EXCESS" -gt 0 ]; then
        # Long debt = sustained unresolved pressure
        LONG_DEBT=$((LONG_DEBT + EXCESS))

        # Short debt = recent pressure density / compact pressure
        SHORT_DEBT=$((SHORT_DEBT + EXCESS))
    else
        LONG_DEBT=$((LONG_DEBT - LONG_DECAY_PER_TICK))
        SHORT_DEBT=$((SHORT_DEBT - SHORT_DECAY_PER_TICK))
    fi

    LONG_DEBT="$(clamp "$LONG_DEBT" 0 "$LONG_DEBT_MAX")"
    SHORT_DEBT="$(clamp "$SHORT_DEBT" 0 "$SHORT_DEBT_MAX")"

    # Effective pressure:
    # long debt gives structure,
    # short density gives urgency only when pressure is compact/recent.
    EFFECTIVE_PRESSURE=$((LONG_DEBT + SHORT_DEBT))

    # Clamp effective pressure so response cannot become ridiculous.
    EFFECTIVE_PRESSURE="$(clamp "$EFFECTIVE_PRESSURE" 0 75)"

    NEW_UP=$((BULK_UP_BASE - EFFECTIVE_PRESSURE * UP_TRIM_PER_PRESSURE))
    NEW_DOWN=$((BULK_DOWN_BASE - EFFECTIVE_PRESSURE * DOWN_TRIM_PER_PRESSURE))

    CUR_BULK_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    CUR_BULK_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    apply_rates

    sleep "$SLEEP_SEC"
done