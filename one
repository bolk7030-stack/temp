#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

# Stable operating envelope
BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

TARGET_DELAY_MS=12

# Desired steering aggressiveness
UP_RESPONSE_GAIN=650
DOWN_RESPONSE_GAIN=950

# Curvature limiter:
# maximum allowed rate movement per tick
MAX_UP_STEP=1800
MAX_DOWN_STEP=3200

# Smooth graph memory
SMOOTH_DELAY=0
SMOOTH_FACTOR_NUM=8
SMOOTH_FACTOR_DEN=10

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

TARGET_BULK_UP="$BULK_UP_BASE"
TARGET_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

approach_target() {
    CURRENT="$1"
    TARGET="$2"
    STEP="$3"

    if [ "$CURRENT" -lt "$TARGET" ]; then
        CURRENT=$((CURRENT + STEP))

        if [ "$CURRENT" -gt "$TARGET" ]; then
            CURRENT="$TARGET"
        fi

    elif [ "$CURRENT" -gt "$TARGET" ]; then
        CURRENT=$((CURRENT - STEP))

        if [ "$CURRENT" -lt "$TARGET" ]; then
            CURRENT="$TARGET"
        fi
    fi

    echo "$CURRENT"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY raw=${DELAY}ms smooth=${SMOOTH_DELAY}ms excess=${EXCESS} up=${CUR_BULK_UP} down=${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    if [ "$WAN_DELAY" -gt "$IFB_DELAY" ]; then
        DELAY="$WAN_DELAY"
    else
        DELAY="$IFB_DELAY"
    fi

    # Curvature smoothing:
    # avoid violent graph transitions
    SMOOTH_DELAY=$(((SMOOTH_DELAY * SMOOTH_FACTOR_NUM + DELAY * (SMOOTH_FACTOR_DEN - SMOOTH_FACTOR_NUM)) / SMOOTH_FACTOR_DEN))

    EXCESS=$((SMOOTH_DELAY - TARGET_DELAY_MS))

    [ "$EXCESS" -lt 0 ] && EXCESS=0

    TARGET_BULK_UP=$((BULK_UP_BASE - EXCESS * UP_RESPONSE_GAIN))
    TARGET_BULK_DOWN=$((BULK_DOWN_BASE - EXCESS * DOWN_RESPONSE_GAIN))

    TARGET_BULK_UP="$(clamp "$TARGET_BULK_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    TARGET_BULK_DOWN="$(clamp "$TARGET_BULK_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    # Graph trajectory minimization:
    # bounded slope movement only
    CUR_BULK_UP="$(approach_target "$CUR_BULK_UP" "$TARGET_BULK_UP" "$MAX_UP_STEP")"
    CUR_BULK_DOWN="$(approach_target "$CUR_BULK_DOWN" "$TARGET_BULK_DOWN" "$MAX_DOWN_STEP")"

    apply_rates

    sleep "$SLEEP_SEC"
done