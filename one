#!/bin/sh
# stream-stats.sh -- interpretation-free time-series diagnostics (v2).
# v1 crashed on busybox awk (user-defined function with many locals). v2 has NO
# user functions -- straight-line code, globals only, busybox-safe.
#
# On timestamps only (no packet "meaning"):
#   1. AUTOCORRELATION of inter-arrival gaps -> hidden periodicity (no assumed period)
#   2. MODALITY of the gap distribution -> single-state vs multi-state process
#   3. STATIONARITY -> did the process drift across the capture
# Done for OUT (console->server) and IN (server->console) separately.
#
# Usage: sh stream-stats.sh [packet_count]   (default 1500)

HOST="192.168.10.50"
COUNT="${1:-1500}"
RAW="/tmp/ss-raw-$$.txt"

echo "Capturing $COUNT game UDP packets for $HOST ... PLAY NOW." >&2
tcpdump -n -tt -c "$COUNT" -i br-lan \
    host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
    2>/dev/null > "$RAW"

LINES=$(wc -l < "$RAW" 2>/dev/null)
echo "captured ${LINES:-0} packets" >&2
if [ "${LINES:-0}" -lt 200 ]; then
    echo "Too few for stable statistics. Aborting." >&2
    rm -f "$RAW"; exit 1
fi

# Split gaps into two files (OUT, IN) with plain awk, then analyse each with a
# second awk that has NO functions. Keeps every awk program busybox-simple.
awk -v HOST="$HOST" '
{
    t=$1+0; src=$3; dst=$5; sub(/:$/,"",dst)
    split(src,sa,"."); si=sa[1]"."sa[2]"."sa[3]"."sa[4]
    split(dst,da,"."); di=da[1]"."da[2]"."da[3]"."da[4]
    isl = (di ~ /^192\.168\./ || di ~ /^239\./ || di ~ /^224\./ || di ~ /^255\./ || si ~ /^192\.168\./ || si ~ /^239\./ || si ~ /^224\./ || si ~ /^255\./)
    if (si==HOST){
        if (di ~ /^192\.168\./ || di ~ /^239\./ || di ~ /^224\./ || di ~ /^255\./) next
        if (lo>0){ g=(t-lo)*1000; if(g>=0 && g<500) print g > "/tmp/ss-out-'$$'.txt" }
        lo=t
    } else if (di==HOST){
        if (si ~ /^192\.168\./ || si ~ /^239\./ || si ~ /^224\./ || si ~ /^255\./) next
        if (li>0){ g=(t-li)*1000; if(g>=0 && g<500) print g > "/tmp/ss-in-'$$'.txt" }
        li=t
    }
}
' "$RAW"

# analysis pass -- NO functions, runs once per direction file
analyse_file() {
    NAME="$1"; F="$2"
    [ -s "$F" ] || { echo "  [$NAME] no samples"; return; }
    awk -v NAME="$NAME" '
    { n++; x[n]=$1+0; sum+=$1 }
    END{
        if(n<30){ printf "  [%s] too few (%d)\n", NAME, n; exit }
        mean=sum/n
        ss=0; mn=1e9; mx=-1e9
        for(i=1;i<=n;i++){ d=x[i]-mean; ss+=d*d; if(x[i]<mn)mn=x[i]; if(x[i]>mx)mx=x[i] }
        sd=sqrt(ss/n)
        printf "\n  === %s inter-arrival (ms) ===\n", NAME
        printf "    n=%d mean=%.2f sd=%.2f cv=%.2f min=%.2f max=%.2f\n", n,mean,sd,(mean>0?sd/mean:0),mn,mx

        # 1. autocorrelation lags 1..40
        acden=0; for(i=1;i<=n;i++){ d=x[i]-mean; acden+=d*d }
        if(acden<=0){ print "    autocorr: no variance"; }
        else {
            print "    autocorrelation peaks (r>0.15):"
            anypk=0
            for(lag=1;lag<=40;lag++){
                s=0; for(i=1;i<=n-lag;i++){ s+=(x[i]-mean)*(x[i+lag]-mean) }
                r[lag]=s/acden
            }
            for(lag=2;lag<=39;lag++){
                if(r[lag]>0.15 && r[lag]>=r[lag-1] && r[lag]>=r[lag+1]){
                    printf "      lag %2d : %+.2f  <= PEAK\n", lag, r[lag]; anypk=1
                }
            }
            if(!anypk) print "      (none -- no hidden periodic structure)"
        }

        # 2. modality (2ms buckets)
        for(i=0;i<60;i++) h[i]=0
        for(i=1;i<=n;i++){ b=int(x[i]/2); if(b<0)b=0; if(b>59)b=59; h[b]++ }
        maxh=0; for(i=0;i<60;i++) if(h[i]>maxh)maxh=h[i]
        modes=0
        for(i=0;i<60;i++){
            if(h[i]>maxh*0.10 && h[i]>=3){
                lo2=(i>0)?h[i-1]:0; hi2=(i<59)?h[i+1]:0
                if(h[i]>=lo2 && h[i]>=hi2) modes++
            }
        }
        printf "    gap distribution modes: %d  (1=single-state, 2+=distinct states)\n", modes
        # show the populated buckets compactly
        for(i=0;i<60;i++){
            if(h[i]>0){
                bl=int(h[i]*24/maxh); bar=""; k=bl; while(k-->0)bar=bar"#"
                printf "      %2d-%2dms |%-24s %d\n", i*2,i*2+1,bar,h[i]
            }
        }

        # 3. stationarity
        half=int(n/2)
        m1=0; for(i=1;i<=half;i++) m1+=x[i]; m1/=half
        m2=0; for(i=half+1;i<=n;i++) m2+=x[i]; m2/=(n-half)
        dm=m1-m2; if(dm<0)dm=-dm
        printf "    stationarity: 1st-half mean=%.2f  2nd-half mean=%.2f  drift=%.2f -> %s\n", \
            m1,m2,dm,(dm>mean*0.15?"NON-stationary":"stationary")
    }' "$F"
}

analyse_file "OUTBOUND" "/tmp/ss-out-$$.txt"
analyse_file "INBOUND"  "/tmp/ss-in-$$.txt"

echo
echo "  interpretation-free: structure of the timing process, not packet meaning."
echo "  run 2-3x; real structure reproduces, noise does not."
rm -f "$RAW" "/tmp/ss-out-$$.txt" "/tmp/ss-in-$$.txt"
