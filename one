#!/bin/sh
WAN_DEV="eth1"; IFB_DEV="ifb-eth1"
GAME_CLASS="1:20"; BULK_CLASS="1:60"

GAME_UP=12000; GAME_DOWN=16000
BULK_UP_BASE=42000; BULK_DOWN_BASE=84000   # standing reservation kept
BULK_UP_MIN=24000;  BULK_DOWN_MIN=52000

TARGET_DELAY_DMS=120          # 12.0 ms

# Soft-knee shape: CONTROL = FIELD*A/(FIELD+B). Bites early, saturates gently.
SHAPE_A=70                    # asymptotic ceiling of P
SHAPE_B=80                    # half-bite at +8ms excess; lower B = earlier bite

# Light field filter: noise rejection only (keep 0.3 old / 0.7 new)
FIELD=0; FIELD_OLD_NUM=3; FIELD_DEN=10

# Tiny leaky-I in centi-units: residual trim, NOT a co-controller
I_ACC=0; I_MAX=80

UP_TRIM_PER_CONTROL=450; DOWN_TRIM_PER_CONTROL=700

# Viscosity = first-order lag at the actuator (front-loaded, smooth)
EMA_NUM=1; EMA_DEN=3

APPLY_EPS_UP=200; APPLY_EPS_DOWN=350   # deadband to cut tc churn at 10 Hz

# --- pick a sub-second sleep method once, at startup ---
SLEEP_US=100000     # 100 ms = 10 Hz target
if sleep 0.1 2>/dev/null; then
    nap() { sleep 0.1; }
    echo "pacing: sleep 0.1 (10 Hz)" >&2
elif usleep 1 2>/dev/null; then
    nap() { usleep "$SLEEP_US"; }
    echo "pacing: usleep ${SLEEP_US} (10 Hz)" >&2
else
    echo "WARN: no sub-second sleep; falling back to 1 Hz" >&2
    nap() { sleep 1; }
fi

CUR_BULK_UP="$BULK_UP_BASE"; CUR_BULK_DOWN="$BULK_DOWN_BASE"
APPLIED_UP=-1; APPLIED_DOWN=-1
LAST_WAN=0; LAST_IFB=0

get_delay_dms() {
    tc -s qdisc show dev "$1" 2>/dev/null | awk '
        /avg_delay/ || /delay/ {
            for (i=1;i<=NF;i++) if ($i ~ /delay/) {
                v=$(i+1); gsub(/[^0-9.]/,"",v); printf "%d\n", int(v*10+0.5); exit }
        }'
}
clamp() { v="$1"; [ "$v" -lt "$2" ] && v="$2"; [ "$v" -gt "$3" ] && v="$3"; echo "$v"; }

# First-order lag toward target, with guaranteed convergence
ema_step() {
    cur="$1"; tgt="$2"; d=$((tgt - cur)); s=$((d * EMA_NUM / EMA_DEN))
    if [ "$s" -eq 0 ] && [ "$d" -ne 0 ]; then [ "$d" -gt 0 ] && s=1 || s=-1; fi
    echo $((cur + s))
}
apply_class() { tc class change dev "$1" classid "$2" hfsc ls rate "${3}kbit" ul rate "${3}kbit" 2>/dev/null; }

# Game lane is static — set once, never touched in the loop
apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

while true; do
    W="$(get_delay_dms "$WAN_DEV")"; I="$(get_delay_dms "$IFB_DEV")"
    [ -z "$W" ] && W="$LAST_WAN"; [ -z "$I" ] && I="$LAST_IFB"
    LAST_WAN="$W"; LAST_IFB="$I"

    WE=$((W - TARGET_DELAY_DMS)); IE=$((I - TARGET_DELAY_DMS))
    [ "$WE" -lt 0 ] && WE=0; [ "$IE" -lt 0 ] && IE=0
    if [ "$WE" -gt "$IE" ]; then MAXE="$WE"; MINE="$IE"; else MAXE="$IE"; MINE="$WE"; fi

    # Smooth shared combine (contraharmonic): mostly worst side, C1 at crossover
    FE=$(( (MAXE*MAXE + MINE*MINE) / (MAXE + MINE + 1) ))

    # Light field filter (noise only)
    FIELD=$(( (FIELD*FIELD_OLD_NUM + FE*(FIELD_DEN-FIELD_OLD_NUM)) / FIELD_DEN ))

    # Soft-knee shape: instant, early-biting, self-saturating
    P_CONTROL=$(( FIELD * SHAPE_A / (FIELD + SHAPE_B) ))

    # Tiny leaky-I, residual only (centi-units so it can't truncate to 0)
    I_ACC=$(( I_ACC * 90 / 100 ))
    [ "$FIELD" -gt 0 ] && I_ACC=$(( I_ACC + FIELD/30 ))
    I_ACC="$(clamp "$I_ACC" 0 "$I_MAX")"
    I_CONTROL=$(( I_ACC / 10 ))

    CONTROL="$(clamp $((P_CONTROL + I_CONTROL)) 0 60)"

    TARGET_UP="$(clamp $((BULK_UP_BASE   - CONTROL*UP_TRIM_PER_CONTROL))   "$BULK_UP_MIN"   "$BULK_UP_BASE")"
    TARGET_DOWN="$(clamp $((BULK_DOWN_BASE - CONTROL*DOWN_TRIM_PER_CONTROL)) "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    CUR_BULK_UP="$(ema_step "$CUR_BULK_UP" "$TARGET_UP")"
    CUR_BULK_DOWN="$(ema_step "$CUR_BULK_DOWN" "$TARGET_DOWN")"

    # Deadband: only touch tc when it actually moved
    du=$((CUR_BULK_UP - APPLIED_UP));   [ "$du" -lt 0 ] && du=$((-du))
    dd=$((CUR_BULK_DOWN - APPLIED_DOWN)); [ "$dd" -lt 0 ] && dd=$((-dd))
    if [ "$du" -ge "$APPLY_EPS_UP" ]   || [ "$CUR_BULK_UP" -eq "$TARGET_UP" ]; then
        apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"; APPLIED_UP="$CUR_BULK_UP"; fi
    if [ "$dd" -ge "$APPLY_EPS_DOWN" ] || [ "$CUR_BULK_DOWN" -eq "$TARGET_DOWN" ]; then
        apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"; APPLIED_DOWN="$CUR_BULK_DOWN"; fi

    echo "W=${W} I=${I} field=$FIELD p=$P_CONTROL i=$I_CONTROL ctl=$CONTROL bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
    nap
done
