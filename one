#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

# Fixed intent lane
GAME_UP=12000
GAME_DOWN=16000

# Bulk valve limits
BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

# Queue-delay target
TARGET_DELAY_MS=12

# Trim strength per ms above target
UP_TRIM_PER_MS=900
DOWN_TRIM_PER_MS=1400

# Slow restore when clean
UP_RESTORE_PER_TICK=1500
DOWN_RESTORE_PER_TICK=2500

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY delay=${DELAY}ms side=$SIDE game=${GAME_UP}/${GAME_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

# Initial baseline
apply_rates

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    if [ "$WAN_DELAY" -gt "$IFB_DELAY" ]; then
        DELAY="$WAN_DELAY"
        SIDE="wan"
    else
        DELAY="$IFB_DELAY"
        SIDE="ifb"
    fi

    if [ "$DELAY" -gt "$TARGET_DELAY_MS" ]; then
        EXCESS=$((DELAY - TARGET_DELAY_MS))

        NEW_UP=$((BULK_UP_BASE - EXCESS * UP_TRIM_PER_MS))
        NEW_DOWN=$((BULK_DOWN_BASE - EXCESS * DOWN_TRIM_PER_MS))

        CUR_BULK_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
        CUR_BULK_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    else
        CUR_BULK_UP=$((CUR_BULK_UP + UP_RESTORE_PER_TICK))
        CUR_BULK_DOWN=$((CUR_BULK_DOWN + DOWN_RESTORE_PER_TICK))

        CUR_BULK_UP="$(clamp "$CUR_BULK_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
        CUR_BULK_DOWN="$(clamp "$CUR_BULK_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"
    fi

    apply_rates

    sleep "$SLEEP_SEC"
done