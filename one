#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

TARGET_DELAY_MS=12

# Irrigation field
FIELD_ENERGY=0
FIELD_MAX=80
TARGET_FIELD=18

FIELD_FILL_GAIN=1
FIELD_DRY_PER_TICK=2

UP_TRIM_PER_FIELD=450
DOWN_TRIM_PER_FIELD=700

# Positive periodic authority pulse
PULSE_ENABLED=1
PULSE_STRENGTH=3
PULSE_PERIOD=3
PULSE_COUNT=0
PULSE_BIAS=0

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY delay=${DELAY}ms side=$SIDE excess=$EXCESS field=$FIELD_ENERGY target=$TARGET_FIELD imbalance=$FIELD_IMBALANCE pulse=$PULSE_BIAS control=$FIELD_CONTROL game=${GAME_UP}/${GAME_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    PULSE_COUNT=$((PULSE_COUNT + 1))

    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    if [ "$WAN_DELAY" -gt "$IFB_DELAY" ]; then
        DELAY="$WAN_DELAY"
        SIDE="wan"
    else
        DELAY="$IFB_DELAY"
        SIDE="ifb"
    fi

    EXCESS=$((DELAY - TARGET_DELAY_MS))
    [ "$EXCESS" -lt 0 ] && EXCESS=0

    if [ "$EXCESS" -gt 0 ]; then
        FIELD_ENERGY=$((FIELD_ENERGY + EXCESS * FIELD_FILL_GAIN))
    else
        FIELD_ENERGY=$((FIELD_ENERGY - FIELD_DRY_PER_TICK))
    fi

    FIELD_ENERGY="$(clamp "$FIELD_ENERGY" 0 "$FIELD_MAX")"

    FIELD_IMBALANCE=$((FIELD_ENERGY - TARGET_FIELD))
    [ "$FIELD_IMBALANCE" -lt 0 ] && FIELD_IMBALANCE=0

    PULSE_BIAS=0

    if [ "$PULSE_ENABLED" -eq 1 ] && [ "$FIELD_ENERGY" -gt 0 ]; then
        PHASE=$((PULSE_COUNT % PULSE_PERIOD))

        if [ "$PHASE" -eq 0 ]; then
            PULSE_BIAS="$PULSE_STRENGTH"
        fi
    fi

    FIELD_CONTROL=$((FIELD_IMBALANCE + PULSE_BIAS))
    [ "$FIELD_CONTROL" -lt 0 ] && FIELD_CONTROL=0

    NEW_UP=$((BULK_UP_BASE - FIELD_CONTROL * UP_TRIM_PER_FIELD))
    NEW_DOWN=$((BULK_DOWN_BASE - FIELD_CONTROL * DOWN_TRIM_PER_FIELD))

    CUR_BULK_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    CUR_BULK_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    apply_rates

    sleep "$SLEEP_SEC"
done