#!/bin/sh
# coherence-lite.sh -- LIGHTER CAKE that stops reshaping your game's multi-flow
# timing (the thing that desynced teammates), while keeping a queue present for
# under-load bufferbloat control.
#
# WHY: full `cake unlimited diffserv4` actively scheduled your game's MULTIPLE
# flows (server + peers) against each other via flow-isolation + tin-sorting +
# ACK-filter + GSO-split. That per-flow reshaping is the likely cause of
# teammates seeming frozen/desynced. This variant removes those behaviors:
#   - besteffort  -> ONE tin; stops sorting server vs peer traffic into tiers
#   - flowblind   -> disables per-flow isolation; stops reshaping flows vs each other
#   - no-ack-filter, no-split-gso -> stops the other two reshaping behaviors
#   - unlimited   -> no bandwidth cap, no added latency
# Net: a queue is present (helps under load) but it no longer meddles with the
# timing relationship between your game's flows.
#
# TEAMMATES ARE THE TEST. Workflow: off (confirm team recovers) -> lite (confirm
# still good) -> compare. If lite reintroduces desync, go fully off (stock).
#
# Usage:
#   sh coherence-lite.sh on       # apply lite CAKE (besteffort flowblind), no mark
#   sh coherence-lite.sh mark     # same + add the CS4 DSCP mark (optional)
#   sh coherence-lite.sh off      # remove -> back to stock mq/fq_codel
#   sh coherence-lite.sh status

WAN="eth1"; HOST="192.168.10.50"; GAMEPORT="3659"

ensure_cake(){
    tc qdisc add dev "$WAN" root handle 9991: cake 2>/dev/null && { tc qdisc del dev "$WAN" root 2>/dev/null; return 0; }
    command -v apk >/dev/null 2>&1 && apk add kmod-sched-cake >/dev/null 2>&1
    command -v opkg >/dev/null 2>&1 && opkg install kmod-sched-cake >/dev/null 2>&1
    tc qdisc add dev "$WAN" root handle 9991: cake 2>/dev/null && { tc qdisc del dev "$WAN" root 2>/dev/null; return 0; }
    return 1
}

apply_lite(){
    ensure_cake || { echo "CAKE unavailable."; return 1; }
    tc qdisc del dev "$WAN" root 2>/dev/null
    # the lightest CAKE: one tin, no flow isolation, no ack-filter, no gso-split, no cap
    tc qdisc add dev "$WAN" root cake unlimited besteffort flowblind no-ack-filter no-split-gso 2>/dev/null \
        || { echo "cake apply failed (older cake may lack a keyword; trying minimal)"; \
             tc qdisc add dev "$WAN" root cake unlimited besteffort flowblind 2>/dev/null || return 1; }
    echo "LITE CAKE applied on $WAN:"
    echo "  unlimited besteffort flowblind no-ack-filter no-split-gso"
    echo "  -> queue present for under-load, but NO per-flow reshaping (the team-desync cause)."
    return 0
}

add_mark(){
    nft add table inet gamedscp 2>/dev/null
    nft 'add chain inet gamedscp postrouting { type filter hook postrouting priority mangle ; policy accept ; }' 2>/dev/null
    nft flush chain inet gamedscp postrouting 2>/dev/null
    nft add rule inet gamedscp postrouting ip saddr "$HOST" udp sport "$GAMEPORT" ip dscp set cs4 counter 2>/dev/null \
        && echo "  + DSCP CS4 mark added (note: besteffort = CAKE ignores it locally; mark only matters downstream)"
}

case "$1" in
    on )   apply_lite ;;
    mark ) apply_lite && add_mark ;;
    off|remove )
        tc qdisc del dev "$WAN" root 2>/dev/null && echo "CAKE removed -> stock mq/fq_codel restored." || echo "(no cake active)"
        nft delete table inet gamedscp 2>/dev/null && echo "DSCP mark removed." || true
        ;;
    status )
        echo "== coherence-lite status =="
        echo "$WAN qdisc:"; tc -s qdisc show dev "$WAN" 2>/dev/null | head -3 | sed 's/^/   /'
        nft list table inet gamedscp >/dev/null 2>&1 && echo "DSCP mark: ACTIVE" || echo "DSCP mark: not active"
        ;;
    * ) echo "usage: sh coherence-lite.sh [on|mark|off|status]" ;;
esac

if [ "$1" = "on" ] || [ "$1" = "mark" ]; then
    echo
    echo "TEAMMATES ARE THE TEST: play a session, watch if they are free again."
    echo "  free again -> lite coexists with team play, keep it."
    echo "  still desynced -> go fully stock: sh coherence-lite.sh off"
fi
