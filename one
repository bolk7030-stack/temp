#!/bin/sh

WAN_DEV="eth1"
HOST="192.168.10.50"
CONSOLE_PORT="3659"

# Safer: do NOT try 10ms first.
# 2-3ms is enough to break true 0ms clumps without destroying handshake bursts.
MIN_GAP_MS="${1:-3}"

PKT_BYTES=150
RATE_BPS=$(( PKT_BYTES * 8 * 1000 / MIN_GAP_MS ))

# Critical fix: allow at least one full packet/MTU through.
BURST_BYTES=1600

# Critical fix: don't drop login/checking bursts immediately.
TBF_LATENCY_MS=250

cleanup() {
    echo "tearing down pacer..."
    tc qdisc del dev "$WAN_DEV" root 2>/dev/null
    echo "done."
}
trap 'cleanup; exit 0' INT TERM EXIT

echo "SAFE pacer active: MIN_GAP=${MIN_GAP_MS}ms rate=${RATE_BPS}bit burst=${BURST_BYTES} latency=${TBF_LATENCY_MS}ms"

tc qdisc del dev "$WAN_DEV" root 2>/dev/null
tc qdisc add dev "$WAN_DEV" root handle 1: prio bands 3 || exit 1

tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: tbf \
    rate "${RATE_BPS}bit" \
    burst "${BURST_BYTES}" \
    latency "${TBF_LATENCY_MS}ms" || {
        echo "tbf failed"
        cleanup
        exit 1
    }

tc qdisc add dev "$WAN_DEV" parent 1:1 handle 10: pfifo 2>/dev/null
tc qdisc add dev "$WAN_DEV" parent 1:3 handle 30: pfifo 2>/dev/null

tc filter add dev "$WAN_DEV" parent 1: protocol ip prio 1 u32 \
    match ip src "${HOST}/32" \
    match ip sport "$CONSOLE_PORT" 0xffff \
    flowid 1:2 || {
        echo "filter failed"
        cleanup
        exit 1
    }

echo "Play now. Ctrl-C to revert."

while true; do
    sleep 10
    tc -s qdisc show dev "$WAN_DEV" | awk '/qdisc tbf 20:/{f=1} f&&/Sent/{print; f=0}'
done