#!/bin/sh

PING_TARGET="1.1.1.1"

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

WAN_CLASS="1:1"
IFB_CLASS="1:1"

BASE_UP=85000
BASE_DOWN=120000

MIN_UP=45000
MIN_DOWN=70000

DROP_PER_MS=2000
SLEEP_SEC=5

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

while true
do
    OUT="$(ping -c 5 -q "$PING_TARGET" 2>/dev/null)"

    MIN="$(echo "$OUT" | awk -F'/' '/round-trip|rtt/ {print int($4)}')"
    MAX="$(echo "$OUT" | awk -F'/' '/round-trip|rtt/ {print int($6)}')"

    [ -z "$MIN" ] && echo "ping failed" && sleep "$SLEEP_SEC" && continue
    [ -z "$MAX" ] && echo "ping failed" && sleep "$SLEEP_SEC" && continue

    JITTER=$((MAX - MIN))

    NEW_UP=$((BASE_UP - (JITTER * DROP_PER_MS)))
    NEW_DOWN=$((BASE_DOWN - (JITTER * DROP_PER_MS)))

    [ "$NEW_UP" -lt "$MIN_UP" ] && NEW_UP="$MIN_UP"
    [ "$NEW_DOWN" -lt "$MIN_DOWN" ] && NEW_DOWN="$MIN_DOWN"

    echo "jitter=${JITTER}ms up=${NEW_UP}kbit down=${NEW_DOWN}kbit"

    if has_class "$WAN_DEV" "$WAN_CLASS"; then
        tc class change dev "$WAN_DEV" classid "$WAN_CLASS" \
            hfsc sc rate "${NEW_UP}kbit" ul rate "${NEW_UP}kbit"
    else
        echo "skip WAN: class missing"
    fi

    if has_class "$IFB_DEV" "$IFB_CLASS"; then
        tc class change dev "$IFB_DEV" classid "$IFB_CLASS" \
            hfsc sc rate "${NEW_DOWN}kbit" ul rate "${NEW_DOWN}kbit"
    else
        echo "skip IFB: class missing"
    fi

    sleep "$SLEEP_SEC"
done
