#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:15"

SLEEP_SEC=1

BASE_GAME_UP=8500
BASE_GAME_DOWN=12000

MAX_GAME_UP=18000
MAX_GAME_DOWN=24000

MIN_GAME_UP=5000
MIN_GAME_DOWN=8000

BOOST=0
BOOST_STEP=1000
BOOST_DECAY=500
MAX_BOOST=10000

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

LAST_WAN=0
LAST_IFB=0
LAST_TOTAL=0

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    WAN_DELTA=$((WAN_PKTS - LAST_WAN))
    IFB_DELTA=$((IFB_PKTS - LAST_IFB))
    TOTAL_DELTA=$((WAN_DELTA + IFB_DELTA))

    if [ "$LAST_TOTAL" -gt 0 ]; then
        DIFF=$((TOTAL_DELTA - LAST_TOTAL))
    else
        DIFF=0
    fi

    REGIME="steady"

    if [ "$TOTAL_DELTA" -eq 0 ]; then
        REGIME="quiet/stall"
        BOOST=$((BOOST + BOOST_STEP))
    elif [ "$DIFF" -gt 20 ]; then
        REGIME="burst/catchup"
        BOOST=$((BOOST - BOOST_DECAY))
    elif [ "$DIFF" -lt -20 ]; then
        REGIME="dropoff/late"
        BOOST=$((BOOST + BOOST_STEP))
    else
        REGIME="steady"
        BOOST=$((BOOST - BOOST_DECAY))
    fi

    [ "$BOOST" -lt 0 ] && BOOST=0
    [ "$BOOST" -gt "$MAX_BOOST" ] && BOOST="$MAX_BOOST"

    NEW_GAME_UP=$((BASE_GAME_UP + BOOST))
    NEW_GAME_DOWN=$((BASE_GAME_DOWN + BOOST))

    [ "$NEW_GAME_UP" -lt "$MIN_GAME_UP" ] && NEW_GAME_UP="$MIN_GAME_UP"
    [ "$NEW_GAME_DOWN" -lt "$MIN_GAME_DOWN" ] && NEW_GAME_DOWN="$MIN_GAME_DOWN"

    [ "$NEW_GAME_UP" -gt "$MAX_GAME_UP" ] && NEW_GAME_UP="$MAX_GAME_UP"
    [ "$NEW_GAME_DOWN" -gt "$MAX_GAME_DOWN" ] && NEW_GAME_DOWN="$MAX_GAME_DOWN"

    echo "wan=$WAN_DELTA ifb=$IFB_DELTA total=$TOTAL_DELTA diff=$DIFF regime=$REGIME boost=$BOOST up=$NEW_GAME_UP down=$NEW_GAME_DOWN"

    if has_class "$WAN_DEV" "$GAME_CLASS"; then
        tc class change dev "$WAN_DEV" classid "$GAME_CLASS" \
            hfsc ls rate "${NEW_GAME_UP}kbit" ul rate "${NEW_GAME_UP}kbit"
    fi

    if has_class "$IFB_DEV" "$GAME_CLASS"; then
        tc class change dev "$IFB_DEV" classid "$GAME_CLASS" \
            hfsc ls rate "${NEW_GAME_DOWN}kbit" ul rate "${NEW_GAME_DOWN}kbit"
    fi

    LAST_WAN="$WAN_PKTS"
    LAST_IFB="$IFB_PKTS"
    LAST_TOTAL="$TOTAL_DELTA"

    sleep "$SLEEP_SEC"
done
