#!/bin/sh
# sensor-scan.sh (v2) -- READ-ONLY scan of real OpenWrt/Protectli sensors.
# v1 HUNG because tcpdump piped to grep with no count/timeout waits forever.
# v2 fix: every capture writes to a FILE with BOTH -c COUNT and a timeout
# guard, then analyses the file. Can't hang, can't lose output.
#
# Run during a LIVE match (sensors 1,1b,2,3 need traffic). Saves a log too.
# Usage: sh sensor-scan.sh

HOST="192.168.10.50"
GAMEPORT="3659"
WAN="eth1"; LAN="br-lan"
CAPN=40          # packets per capture
CAPT=10          # max seconds per capture (safety)
LOG="/tmp/sensor-scan.log"
LINE="------------------------------------------------------------"
say(){ echo; echo "$LINE"; echo "== $1"; echo "$LINE"; }

# capture helper: writes to file, stops at CAPN packets OR CAPT seconds.
# uses timeout if available; busybox timeout may kill early but -c usually
# fills first on a live match. Either way it CANNOT hang forever.
cap(){
    IFACE="$1"; OUT="$2"
    if command -v timeout >/dev/null 2>&1; then
        timeout "$CAPT" tcpdump -n -v -c "$CAPN" -i "$IFACE" \
            host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
            2>/dev/null > "$OUT"
    else
        tcpdump -n -v -c "$CAPN" -i "$IFACE" \
            host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
            2>/dev/null > "$OUT" &
        TPID=$!
        i=0; while [ "$i" -lt "$CAPT" ]; do sleep 1; kill -0 "$TPID" 2>/dev/null || break; i=$((i+1)); done
        kill "$TPID" 2>/dev/null
    fi
}

{
echo "sensor-scan v2  $(date 2>/dev/null)"
echo "PLAY a match so captures fill fast. Each capture: max ${CAPN} pkts / ${CAPT}s."

say "SENSOR 1 -- DSCP/ToS on game packets, CONSOLE side ($LAN)"
echo "HYP: game marks its UDP priority; we may be ignoring/erasing it."
echo "0x0=unmarked  0x60=CS3  0xb8=EF  0x80=CS4  0x88=AF41"
cap "$LAN" /tmp/ss-lan.txt
echo "tos values seen (count, value):"
grep -o 'tos 0x[0-9a-fA-F]*' /tmp/ss-lan.txt | sort | uniq -c | sed 's/^/   /'
[ -s /tmp/ss-lan.txt ] || echo "   (no packets captured -- in a match?)"

say "SENSOR 1b -- does the mark SURVIVE the router? EGRESS side ($WAN)"
echo "If marked at $LAN above but 0x0 here -> router is WASHING the DSCP."
cap "$WAN" /tmp/ss-wan.txt
echo "tos values seen on egress (count, value):"
grep -o 'tos 0x[0-9a-fA-F]*' /tmp/ss-wan.txt | sort | uniq -c | sed 's/^/   /'
[ -s /tmp/ss-wan.txt ] || echo "   (no packets captured -- in a match?)"
echo
echo "VERDICT: compare the two. same nonzero = preserved. nonzero->0x0 = WASHED."

say "SENSOR 2 -- conntrack flow state"
if command -v conntrack >/dev/null 2>&1; then
    conntrack -L -p udp 2>/dev/null | grep "$GAMEPORT" | head -6 | sed 's/^/   /'
else
    grep "$GAMEPORT" /proc/net/nf_conntrack 2>/dev/null | head -6 | sed 's/^/   /'
fi
echo "   (empty = flow not active during scan; play during run)"

say "SENSOR 3 -- qdisc backlog on $WAN (read again under load to compare)"
tc -s qdisc show dev "$WAN" 2>/dev/null | sed 's/^/   /'

say "SENSOR 4 -- NIC interrupt coalescing (is the outbound burst hardware?)"
if command -v ethtool >/dev/null 2>&1; then
    ethtool -c "$WAN" 2>/dev/null | grep -iE 'rx-usecs|tx-usecs|rx-frames|tx-frames|adaptive' | sed 's/^/   /'
else
    echo "   ethtool not installed: apk add ethtool"
fi
echo "   rx/tx-usecs > 0 or adaptive on = coalescing ON = likely burst cause."

say "SENSOR 5 -- softirq balance"
grep -E 'NET_RX|NET_TX' /proc/softirqs 2>/dev/null | sed 's/^/   /'
uptime 2>/dev/null | sed 's/^/   load: /'

echo
echo "$LINE"
echo "KEY FEEDBACK: Sensor 1 vs 1b tos values, and Sensor 4 coalescing on/off."
echo "$LINE"
} 2>&1 | tee "$LOG"

rm -f /tmp/ss-lan.txt /tmp/ss-wan.txt
echo
echo ">>> saved to $LOG  (cat $LOG to re-read)"
