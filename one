#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"

# Bulk ladder pockets
BULK_LIGHT="1:30"
BULK_SUSPECT="1:31"
BULK_PRESSURE="1:32"
BULK_QUARANTINE="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

# Sensors
DROP_DEADBAND=180
SPIKE_DEADBAND=150

SPIKE_CONFIRM=2
DROP_CONFIRM=2

YELLOW_REQUIRED=6
RED_REQUIRED=18
GREEN_REQUIRED=12

AVG_DELTA=0
LAST_TOTAL=0
SEEDED=0

SPIKE_COUNT=0
DROP_COUNT=0
BAD_COUNT=0
GOOD_COUNT=0

LAST_MODE="none"

DEBUG=1

log() {
    [ "$DEBUG" -eq 1 ] && echo "$1"
}

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls { found=1; next }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    if has_class "$DEV" "$CLASS"; then
        tc class change dev "$DEV" classid "$CLASS" \
            hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit"
    else
        echo "WARN missing class dev=$DEV class=$CLASS"
    fi
}

apply_mode() {
    MODE="$1"

    # Always protect game lane
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    case "$MODE" in
        green)
            # coexistence: most room, no artificial steel
            apply_class "$WAN_DEV" "$BULK_LIGHT" 45000
            apply_class "$IFB_DEV" "$BULK_LIGHT" 90000

            apply_class "$WAN_DEV" "$BULK_SUSPECT" 40000
            apply_class "$IFB_DEV" "$BULK_SUSPECT" 85000

            apply_class "$WAN_DEV" "$BULK_PRESSURE" 36000
            apply_class "$IFB_DEV" "$BULK_PRESSURE" 78000

            apply_class "$WAN_DEV" "$BULK_QUARANTINE" 30000
            apply_class "$IFB_DEV" "$BULK_QUARANTINE" 70000
            ;;

        yellow)
            # separation: suspect pocket absorbs pressure first
            apply_class "$WAN_DEV" "$BULK_LIGHT" 45000
            apply_class "$IFB_DEV" "$BULK_LIGHT" 90000

            apply_class "$WAN_DEV" "$BULK_SUSPECT" 33000
            apply_class "$IFB_DEV" "$BULK_SUSPECT" 72000

            apply_class "$WAN_DEV" "$BULK_PRESSURE" 30000
            apply_class "$IFB_DEV" "$BULK_PRESSURE" 65000

            apply_class "$WAN_DEV" "$BULK_QUARANTINE" 26000
            apply_class "$IFB_DEV" "$BULK_QUARANTINE" 60000
            ;;

        red)
            # quarantine: staged pressure, not one violent clamp
            apply_class "$WAN_DEV" "$BULK_LIGHT" 43000
            apply_class "$IFB_DEV" "$BULK_LIGHT" 85000

            apply_class "$WAN_DEV" "$BULK_SUSPECT" 30000
            apply_class "$IFB_DEV" "$BULK_SUSPECT" 65000

            apply_class "$WAN_DEV" "$BULK_PRESSURE" 26000
            apply_class "$IFB_DEV" "$BULK_PRESSURE" 58000

            apply_class "$WAN_DEV" "$BULK_QUARANTINE" 22000
            apply_class "$IFB_DEV" "$BULK_QUARANTINE" 52000
            ;;
    esac

    echo "APPLY mode=$MODE game=$GAME_UP/$GAME_DOWN ladder=${BULK_LIGHT},${BULK_SUSPECT},${BULK_PRESSURE},${BULK_QUARANTINE}"
}

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        LAST_MODE="green"
        apply_mode green
        log "seed total=$TOTAL"
        sleep "$SLEEP_SEC"
        continue
    fi

    DELTA=$((TOTAL - LAST_TOTAL))
    [ "$DELTA" -lt 0 ] && DELTA=0

    OLD_AVG="$AVG_DELTA"
    AVG_DELTA=$(((AVG_DELTA * 85 + DELTA * 15) / 100))

    DROP=$((OLD_AVG - DELTA))
    [ "$DROP" -lt 0 ] && DROP=0

    SPIKE=$((DELTA - OLD_AVG))
    [ "$SPIKE" -lt 0 ] && SPIKE=0

    if [ "$SPIKE" -gt "$SPIKE_DEADBAND" ]; then
        SPIKE_COUNT=$((SPIKE_COUNT + 1))
    else
        [ "$SPIKE_COUNT" -gt 0 ] && SPIKE_COUNT=$((SPIKE_COUNT - 1))
    fi

    if [ "$DROP" -gt "$DROP_DEADBAND" ]; then
        DROP_COUNT=$((DROP_COUNT + 1))
    else
        [ "$DROP_COUNT" -gt 0 ] && DROP_COUNT=$((DROP_COUNT - 1))
    fi

    BAD=0
    REASON="clean"

    if [ "$SPIKE_COUNT" -ge "$SPIKE_CONFIRM" ]; then
        BAD=1
        REASON="spike"
    fi

    if [ "$DROP_COUNT" -ge "$DROP_CONFIRM" ]; then
        BAD=1
        REASON="drop"
    fi

    if [ "$BAD" -eq 1 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        [ "$BAD_COUNT" -gt 0 ] && BAD_COUNT=$((BAD_COUNT - 1))
    fi

    MODE="$LAST_MODE"

    if [ "$BAD_COUNT" -ge "$RED_REQUIRED" ]; then
        MODE="red"
    elif [ "$BAD_COUNT" -ge "$YELLOW_REQUIRED" ]; then
        MODE="yellow"
    elif [ "$GOOD_COUNT" -ge "$GREEN_REQUIRED" ]; then
        MODE="green"
    fi

    log "delta=$DELTA avg=$AVG_DELTA spike=$SPIKE drop=$DROP spike_count=$SPIKE_COUNT drop_count=$DROP_COUNT reason=$REASON bad=$BAD_COUNT good=$GOOD_COUNT mode=$MODE"

    if [ "$MODE" != "$LAST_MODE" ]; then
        apply_mode "$MODE"
        LAST_MODE="$MODE"
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
