#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:15"

SLEEP_SEC=1

BASE_GAME_UP=8500
BASE_GAME_DOWN=12000

MAX_GAME_UP=18000
MAX_GAME_DOWN=24000

MIN_GAME_UP=5000
MIN_GAME_DOWN=8000

# Smooth baseline authority
BOOST=0
MAX_BOOST=6500
FACTOR=120
BASE_PULSE=50
MEMORY_NUM=6
MEMORY_DEN=10

# Short impulse / burst authority
SPIKE=0
SPIKE_STEP=1800
SPIKE_DECAY=700
MAX_SPIKE=3000

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

LAST_TOTAL=0

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))
    DELTA=$((TOTAL - LAST_TOTAL))

    # Obligation signal from packet cadence
    if [ "$DELTA" -le 0 ]; then
        SIGNAL=6
    elif [ "$DELTA" -lt 5 ]; then
        SIGNAL=5
    elif [ "$DELTA" -lt 15 ]; then
        SIGNAL=3
    else
        SIGNAL=1
    fi

    TARGET=$((BASE_PULSE + SIGNAL * FACTOR))

    # Smooth baseline controller:
    # BOOST = 0.6 old + 0.4 target
    BOOST=$(((BOOST * MEMORY_NUM + TARGET * (MEMORY_DEN - MEMORY_NUM)) / MEMORY_DEN))

    [ "$BOOST" -lt 0 ] && BOOST=0
    [ "$BOOST" -gt "$MAX_BOOST" ] && BOOST="$MAX_BOOST"

    # Impulse layer:
    # quick burst when cadence is quiet/low, fast decay otherwise
    if [ "$DELTA" -le 1 ]; then
        SPIKE=$((SPIKE + SPIKE_STEP))
    else
        SPIKE=$((SPIKE - SPIKE_DECAY))
    fi

    [ "$SPIKE" -lt 0 ] && SPIKE=0
    [ "$SPIKE" -gt "$MAX_SPIKE" ] && SPIKE="$MAX_SPIKE"

    NEW_GAME_UP=$((BASE_GAME_UP + BOOST + SPIKE))
    NEW_GAME_DOWN=$((BASE_GAME_DOWN + BOOST + SPIKE))

    [ "$NEW_GAME_UP" -lt "$MIN_GAME_UP" ] && NEW_GAME_UP="$MIN_GAME_UP"
    [ "$NEW_GAME_DOWN" -lt "$MIN_GAME_DOWN" ] && NEW_GAME_DOWN="$MIN_GAME_DOWN"

    [ "$NEW_GAME_UP" -gt "$MAX_GAME_UP" ] && NEW_GAME_UP="$MAX_GAME_UP"
    [ "$NEW_GAME_DOWN" -gt "$MAX_GAME_DOWN" ] && NEW_GAME_DOWN="$MAX_GAME_DOWN"

    echo "delta=$DELTA signal=$SIGNAL target=$TARGET boost=$BOOST spike=$SPIKE up=$NEW_GAME_UP down=$NEW_GAME_DOWN"

    if has_class "$WAN_DEV" "$GAME_CLASS"; then
        tc class change dev "$WAN_DEV" classid "$GAME_CLASS" \
            hfsc ls rate "${NEW_GAME_UP}kbit" ul rate "${NEW_GAME_UP}kbit"
    fi

    if has_class "$IFB_DEV" "$GAME_CLASS"; then
        tc class change dev "$IFB_DEV" classid "$GAME_CLASS" \
            hfsc ls rate "${NEW_GAME_DOWN}kbit" ul rate "${NEW_GAME_DOWN}kbit"
    fi

    LAST_TOTAL="$TOTAL"

    sleep "$SLEEP_SEC"
done
