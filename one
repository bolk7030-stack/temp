#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:15"
BULK_CLASS="1:30"

SLEEP_SEC=1

# Fixed game authority lane
GAME_UP=12000
GAME_DOWN=16000

# Background traffic control range
BULK_UP_GREEN=45000
BULK_DOWN_GREEN=90000

BULK_UP_YELLOW=25000
BULK_DOWN_YELLOW=50000

BULK_UP_RED=12000
BULK_DOWN_RED=25000

# Sensor memory
AVG_DELTA=0
LAST_TOTAL=0
SEEDED=0

# Sensitivity
DROP_DEADBAND=2
SPIKE_DEADBAND=4

YELLOW_REQUIRED=2
RED_REQUIRED=4
GREEN_REQUIRED=8

BAD_COUNT=0
GOOD_COUNT=0

LAST_MODE="none"

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    if has_class "$DEV" "$CLASS"; then
        tc class change dev "$DEV" classid "$CLASS" \
            hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit"
    fi
}

apply_mode() {
    MODE="$1"

    case "$MODE" in
        green)
            BULK_UP="$BULK_UP_GREEN"
            BULK_DOWN="$BULK_DOWN_GREEN"
            ;;
        yellow)
            BULK_UP="$BULK_UP_YELLOW"
            BULK_DOWN="$BULK_DOWN_YELLOW"
            ;;
        red)
            BULK_UP="$BULK_UP_RED"
            BULK_DOWN="$BULK_DOWN_RED"
            ;;
    esac

    # Keep game lane fixed. No live steering.
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    # Only manipulate non-game pressure.
    apply_class "$WAN_DEV" "$BULK_CLASS" "$BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$BULK_DOWN"

    echo "APPLY mode=$MODE game_up=$GAME_UP game_down=$GAME_DOWN bulk_up=$BULK_UP bulk_down=$BULK_DOWN"
}

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        apply_mode green
        LAST_MODE="green"
        echo "seed total=$TOTAL"
        sleep "$SLEEP_SEC"
        continue
    fi

    DELTA=$((TOTAL - LAST_TOTAL))

    if [ "$DELTA" -lt 0 ]; then
        DELTA=0
        AVG_DELTA=0
        BAD_COUNT=0
        GOOD_COUNT=0
        echo "counter-reset detected"
    fi

    OLD_AVG="$AVG_DELTA"
    AVG_DELTA=$(((AVG_DELTA * 6 + DELTA * 4) / 10))

    DROP=$((OLD_AVG - DELTA))
    [ "$DROP" -lt 0 ] && DROP=0

    SPIKE=$((DELTA - OLD_AVG))
    [ "$SPIKE" -lt 0 ] && SPIKE=0

    BAD=0

    # Micro instability: sudden packet drop after expected activity
    if [ "$DROP" -gt "$DROP_DEADBAND" ]; then
        BAD=1
    fi

    # Burst instability: sudden spike means protect lane before queue forms
    if [ "$SPIKE" -gt "$SPIKE_DEADBAND" ]; then
        BAD=1
    fi

    if [ "$BAD" -eq 1 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        BAD_COUNT=0
    fi

    MODE="$LAST_MODE"

    if [ "$BAD_COUNT" -ge "$RED_REQUIRED" ]; then
        MODE="red"
    elif [ "$BAD_COUNT" -ge "$YELLOW_REQUIRED" ]; then
        MODE="yellow"
    elif [ "$GOOD_COUNT" -ge "$GREEN_REQUIRED" ]; then
        MODE="green"
    fi

    echo "delta=$DELTA avg=$AVG_DELTA drop=$DROP spike=$SPIKE bad=$BAD bad_count=$BAD_COUNT good_count=$GOOD_COUNT mode=$MODE"

    if [ "$MODE" != "$LAST_MODE" ]; then
        apply_mode "$MODE"
        LAST_MODE="$MODE"
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
