#!/bin/sh
# qos-audit-git.sh
# Runs QoS audit -> saves log -> commits -> pushes to GitHub automatically

TAG="${1:-run}"

# =========================
# CONFIG
# =========================

REPO_DIR="/root/temp"
BRANCH="main"

GITHUB_USER="bolk7030-stack"
GITHUB_TOKEN="ghp_WyiNYZ0aGRJ6H25VbRBKKEHSPSt008mbEu"

# Example:
# REPO_URL="https://github.com/yourname/temp.git"
REPO_URL="https://github.com/bolk7030-stack/temp.service status"

#!/bin/sh
# qdit.sh -- jitter probe + GitHub upload

# Usage:
#   ./qdit.sh                 -> 30 sec, both directions
#   ./qdit.sh 60              -> 60 sec, both directions
#   ./qdit.sh 30 out          -> 30 sec outbound only
#   ./qdit.sh 30 in           -> 30 sec inbound only

HOST="192.168.1.50"
DUR="${1:-30}"
DIR="${2:-both}"

REPO_NAME="temp"

PARENT_DIR="/root"
REPO_DIR="${PARENT_DIR}/${REPO_NAME}"
AUTH_REPO_URL="https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/${GITHUB_USER}/${REPO_NAME}.git"

TS="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)"
OUT="/tmp/jitter-probe-${TS}-${DIR}.log"
RAW="/tmp/jp-raw-$$.txt"

{
LINE="---------------------------------------------------------------"
say() { echo; echo "$LINE"; echo "== $1"; echo "$LINE"; }

say "JITTER PROBE"
echo "time     : $TS"
echo "host     : $HOST"
echo "duration : ${DUR}s"
echo "dir      : $DIR"

case "$DIR" in
    out) FILT="src host $HOST" ;;
    in)  FILT="dst host $HOST" ;;
    *)   FILT="host $HOST" ;;
esac

FILT="$FILT and udp"
IFACE="any"

say "CAPTURE"
echo "Capturing ${DUR}s of UDP traffic for $HOST ($DIR)"
echo "interface: $IFACE"
echo "filter   : $FILT"
echo "PLAY NOW."

timeout "$DUR" tcpdump -n -tt -i "$IFACE" -q "$FILT" 2>/dev/null > "$RAW"

LINES=$(wc -l < "$RAW" 2>/dev/null)
echo
echo "captured packets: ${LINES:-0}"

if [ "${LINES:-0}" -lt 10 ]; then
    echo
    echo "TOO FEW PACKETS."
    echo "Possible reasons:"
    echo "  wrong device IP"
    echo "  not in live match"
    echo "  game uses TCP"
    echo "  tcpdump cannot see traffic on interface '$IFACE'"
    echo
    echo "Try manually:"
    echo "  tcpdump -n -i any host $HOST"
else
    say "INTER-PACKET TIMING ANALYSIS"

    awk '
    {
        t = $1 + 0
        if (prev > 0) {
            gap = (t - prev) * 1000.0
            if (gap >= 0 && gap < 1000) {
                n++
                sum += gap
                gaps[n] = gap
                if (min=="" || gap < min) min = gap
                if (gap > max) max = gap
            }
        }
        prev = t
    }
    END {
        if (n < 5) {
            print "not enough gaps to analyse"
            exit
        }

        mean = sum / n

        for (i=1;i<=n;i++) {
            d = gaps[i]-mean
            ss += d*d
        }

        sd = sqrt(ss/n)

        for (i=2;i<=n;i++) {
            k=gaps[i]
            j=i-1
            while(j>=1 && gaps[j]>k) {
                gaps[j+1]=gaps[j]
                j--
            }
            gaps[j+1]=k
        }

        p50 = gaps[int(n*0.50)]
        p95 = gaps[int(n*0.95)]
        p99 = gaps[int(n*0.99)]

        printf "packets analysed : %d\n", n+1
        printf "mean gap         : %.2f ms\n", mean
        printf "min / max        : %.2f / %.2f ms\n", min, max
        printf "median p50       : %.2f ms\n", p50
        printf "p95 / p99        : %.2f / %.2f ms\n", p95, p99
        printf "JITTER std dev   : %.2f ms\n", sd
        printf "spread max-min   : %.2f ms\n", max-min
        printf "\n"

        printf "READING:\n"
        if (sd < 1.0)
            printf "  jitter < 1ms  -> stream is very steady at router.\n"
        else if (sd < 3.0)
            printf "  jitter 1-3ms  -> mild local wobble.\n"
        else
            printf "  jitter > 3ms  -> real local wobble worth investigating.\n"
    }
    ' "$RAW"
fi

rm -f "$RAW"

echo
echo "$LINE"
echo "DONE."
echo "$LINE"

} 2>&1 | tee "$OUT"

echo
echo "saved jitter log to: $OUT"

# =========================
# GIT PUSH SECTION
# =========================

mkdir -p "$PARENT_DIR"

if [ ! -d "$REPO_DIR/.git" ]; then
    echo "Repo not found. Cloning into $REPO_DIR..."
    rm -rf "$REPO_DIR"
    git clone "$AUTH_REPO_URL" "$REPO_DIR" || {
        echo "ERROR: git clone failed"
        exit 1
    }
fi

cd "$REPO_DIR" || {
    echo "ERROR: cannot cd into $REPO_DIR"
    exit 1
}

git config user.name "openwrt-jitter"
git config user.email "openwrt-jitter@local"

git pull --rebase "$AUTH_REPO_URL" "$BRANCH" || {
    echo "ERROR: pull/rebase failed"
    exit 1
}

mkdir -p jitter

DEST="jitter/$(basename "$OUT")"
cp "$OUT" "$DEST"

git add jitter/

git commit -m "jitter probe ${TS} ${DIR}" || {
    echo "Nothing new to commit."
    exit 0
}

git push "$AUTH_REPO_URL" "$BRANCH" || {
    echo "ERROR: git push failed"
    exit 1
}

echo "GitHub push complete."    echo "ERROR: git push failed"
    exit 1
}