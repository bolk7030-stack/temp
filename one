#!/bin/sh
# phase-auto.sh -- all-in-one: install deps, find the best egress phase delay,
# then apply it and hold continuously.
#
# Working assumption (yours): response-delay is bimodal (~7ms fast / ~22ms slow,
# ~15ms apart => ~60Hz tick). Goal: pick the small egress delay that puts the
# most response mass into the fast (<=14ms) region, then keep it applied.
#
# Flow:
#   1. ensure netem is installed (apk).
#   2. SWEEP candidate delays while you play -> measure FAST-FRACTION at each.
#   3. pick the delay with the highest FAST-FRACTION (the best phase alignment).
#   4. APPLY that delay to the console's game traffic and HOLD until Ctrl-C.
#
# Touches ONLY the console's game UDP (src 192.168.10.50 port 3659) on eth1
# egress. Everything else is untouched. Tears down cleanly on exit.
#
# Usage:
#   sh phase-auto.sh                  # sweep 0 3 6 9 12, auto-apply best, hold
#   sh phase-auto.sh "0 4 8 12 16"    # custom candidate delays
#   sh phase-auto.sh hold 7           # skip sweep, just apply 7ms and hold
#
# RUN IT WHILE PLAYING. The sweep needs the live game stream to measure.
# To survive SSH disconnect:  setsid sh phase-auto.sh &   (or run in screen/tmux)

WAN_DEV="eth1"
HOST="192.168.10.50"
CONSOLE_PORT="3659"
PKTS=200

cleanup() {
    echo >&2
    echo "tearing down egress shaper on $WAN_DEV ..." >&2
    tc qdisc del dev "$WAN_DEV" root 2>/dev/null
    echo "done. $WAN_DEV restored to default. (game traffic no longer delayed)" >&2
}
trap 'cleanup; exit 0' INT TERM

# ---------- 1. ensure netem ----------
ensure_netem() {
    # quick capability test: can we add a netem qdisc?
    if tc qdisc add dev "$WAN_DEV" root handle 99: netem delay 1ms 2>/dev/null; then
        tc qdisc del dev "$WAN_DEV" root 2>/dev/null
        echo "netem: available" >&2
        return 0
    fi
    echo "netem: not available, installing kmod-sched-netem via apk ..." >&2
    if command -v apk >/dev/null 2>&1; then
        apk update >/dev/null 2>&1
        apk add kmod-sched-netem >/dev/null 2>&1
    elif command -v opkg >/dev/null 2>&1; then
        opkg update >/dev/null 2>&1
        opkg install kmod-sched-netem >/dev/null 2>&1
    else
        echo "ERROR: no apk or opkg found; cannot install netem." >&2
        return 1
    fi
    # re-test
    if tc qdisc add dev "$WAN_DEV" root handle 99: netem delay 1ms 2>/dev/null; then
        tc qdisc del dev "$WAN_DEV" root 2>/dev/null
        echo "netem: installed OK" >&2
        return 0
    fi
    echo "ERROR: netem still unavailable after install attempt." >&2
    return 1
}

# ---------- build a delay shaper for the console's game traffic ----------
build_delay() {
    D="$1"
    tc qdisc del dev "$WAN_DEV" root 2>/dev/null
    tc qdisc add dev "$WAN_DEV" root handle 1: prio bands 3 || return 1
    if [ "$D" -gt 0 ]; then
        tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: netem delay "${D}ms" || return 1
    else
        tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: pfifo || return 1
    fi
    tc qdisc add dev "$WAN_DEV" parent 1:1 handle 10: pfifo 2>/dev/null
    tc qdisc add dev "$WAN_DEV" parent 1:3 handle 30: pfifo 2>/dev/null
    tc filter add dev "$WAN_DEV" parent 1: protocol ip prio 1 u32 \
        match ip src "${HOST}/32" match ip sport "$CONSOLE_PORT" 0xffff \
        flowid 1:2 || return 1
    return 0
}

# ---------- measure FAST-FRACTION (% responses <=14ms). echoes the integer % ----------
measure_fastfrac() {
    RAW="/tmp/auto-raw-$$.txt"
    tcpdump -n -tt -c "$PKTS" -i br-lan \
        host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
        2>/dev/null > "$RAW"
    awk -v HOST="$HOST" '
    function islocal(ip){ return (ip ~ /^192\.168\./ || ip ~ /^239\./ || ip ~ /^224\./ || ip ~ /^255\./) }
    {
        t=$1+0; src=$3; dst=$5; sub(/:$/,"",dst)
        split(src,sa,"."); si=sa[1]"."sa[2]"."sa[3]"."sa[4]
        split(dst,da,"."); di=da[1]"."da[2]"."da[3]"."da[4]
        if (si==HOST){o=di;out=1} else if(di==HOST){o=si;out=0} else next
        if (islocal(o)) next
        if (out){ lo=t } else if(lo>0){ rd=(t-lo)*1000; if(rd>=0&&rd<200){rc++; if(rd<=14)f++} }
    }
    END{ if(rc<10) print -1; else print int(f*100/rc) }
    ' "$RAW"
    rm -f "$RAW"
}

# ===================== MAIN =====================

# hold-only mode: sh phase-auto.sh hold 7
if [ "$1" = "hold" ]; then
    ensure_netem || exit 1
    D="${2:-7}"
    build_delay "$D" || { echo "build failed"; cleanup; exit 1; }
    echo "HOLDING ${D}ms egress delay on console game traffic. Ctrl-C to stop." >&2
    while true; do sleep 3600; done
fi

# candidate delays
case "$1" in
    *" "* ) CANDIDATES="$1" ;;
    "" ) CANDIDATES="0 3 6 9 12" ;;
    * ) CANDIDATES="0 3 6 9 12" ;;
esac

ensure_netem || exit 1

echo "=== PHASE SWEEP (play continuously) ===" >&2
echo "candidates: $CANDIDATES ms   |   $PKTS pkts each" >&2

BEST_D=0; BEST_F=-1
for D in $CANDIDATES; do
    build_delay "$D" || { echo "build failed at ${D}ms"; cleanup; exit 1; }
    sleep 2
    F="$(measure_fastfrac)"
    if [ "$F" -lt 0 ]; then
        echo "  ${D}ms -> too few pairs (keep playing / moving)" >&2
    else
        echo "  ${D}ms -> FAST-FRACTION ${F}%" >&2
        if [ "$F" -gt "$BEST_F" ]; then BEST_F="$F"; BEST_D="$D"; fi
    fi
done

echo >&2
if [ "$BEST_F" -lt 0 ]; then
    echo "No usable measurements (no game pairs seen). Are you in a live match?" >&2
    cleanup; exit 1
fi

echo "BEST: ${BEST_D}ms delay gave ${BEST_F}% fast responses." >&2

# Sanity: if 0ms was already the best (or tied), egress delay doesn't help.
if [ "$BEST_D" -eq 0 ]; then
    echo "0ms was best -> egress phase delay does NOT improve fast-fraction." >&2
    echo "The phase split is server-side; you don't control it here. Reverting." >&2
    cleanup; exit 0
fi

echo "Applying ${BEST_D}ms and HOLDING. Play on. Ctrl-C to revert." >&2
build_delay "$BEST_D" || { echo "final apply failed"; cleanup; exit 1; }
while true; do sleep 3600; done
