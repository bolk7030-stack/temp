#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

TARGET_DELAY_MS=12

# Irrigation field
FIELD_ENERGY=0
FIELD_MAX=80
TARGET_FIELD=18

FIELD_FILL_GAIN=1
FIELD_DRY_PER_TICK=2

# Dielectric resistance:
# repeated pressure charges the tunnel
DIELECTRIC_CHARGE=0
LAST_DIELECTRIC_CHARGE=0
DIELECTRIC_MAX=40
DIELECTRIC_FILL_GAIN=1
DIELECTRIC_LEAK_PER_TICK=1

# Dielectric only charges after pressure is actually meaningful
DIELECTRIC_EXCESS_GATE=3

# Dielectric bite:
# sharpness only when tunnel charge is actively increasing
DIELECTRIC_BITE_GAIN=2

# Blend strength
UP_TRIM_PER_CONTROL=450
DOWN_TRIM_PER_CONTROL=700

# Viscosity mandate:
# output seeps toward target instead of teleporting
MAX_UP_STEP=1200
MAX_DOWN_STEP=2200

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

approach_target() {
    CURRENT="$1"
    TARGET="$2"
    STEP="$3"

    if [ "$CURRENT" -lt "$TARGET" ]; then
        CURRENT=$((CURRENT + STEP))
        [ "$CURRENT" -gt "$TARGET" ] && CURRENT="$TARGET"
    elif [ "$CURRENT" -gt "$TARGET" ]; then
        CURRENT=$((CURRENT - STEP))
        [ "$CURRENT" -lt "$TARGET" ] && CURRENT="$TARGET"
    fi

    echo "$CURRENT"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY delay=${DELAY}ms side=$SIDE excess=$EXCESS field=$FIELD_ENERGY imbalance=$FIELD_IMBALANCE dielectric=$DIELECTRIC_CHARGE bite=$DIELECTRIC_BITE control=$FIELD_CONTROL target_bulk=${TARGET_UP}/${TARGET_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    if [ "$WAN_DELAY" -gt "$IFB_DELAY" ]; then
        DELAY="$WAN_DELAY"
        SIDE="wan"
    else
        DELAY="$IFB_DELAY"
        SIDE="ifb"
    fi

    EXCESS=$((DELAY - TARGET_DELAY_MS))
    [ "$EXCESS" -lt 0 ] && EXCESS=0

    # Irrigation field: sustained playable flow
    if [ "$EXCESS" -gt 0 ]; then
        FIELD_ENERGY=$((FIELD_ENERGY + EXCESS * FIELD_FILL_GAIN))
    else
        FIELD_ENERGY=$((FIELD_ENERGY - FIELD_DRY_PER_TICK))
    fi

    FIELD_ENERGY="$(clamp "$FIELD_ENERGY" 0 "$FIELD_MAX")"

    FIELD_IMBALANCE=$((FIELD_ENERGY - TARGET_FIELD))
    [ "$FIELD_IMBALANCE" -lt 0 ] && FIELD_IMBALANCE=0

    # Dielectric tunnel:
    # repeated meaningful excess charges resistance.
    # clean periods leak charge slowly.
    if [ "$EXCESS" -ge "$DIELECTRIC_EXCESS_GATE" ]; then
        DIELECTRIC_CHARGE=$((DIELECTRIC_CHARGE + EXCESS * DIELECTRIC_FILL_GAIN))
    else
        DIELECTRIC_CHARGE=$((DIELECTRIC_CHARGE - DIELECTRIC_LEAK_PER_TICK))
    fi

    DIELECTRIC_CHARGE="$(clamp "$DIELECTRIC_CHARGE" 0 "$DIELECTRIC_MAX")"

    # Dielectric bite:
    # charge growth creates sharpness only while the tunnel is being tested.
    DIELECTRIC_BITE=$((DIELECTRIC_CHARGE - LAST_DIELECTRIC_CHARGE))
    [ "$DIELECTRIC_BITE" -lt 0 ] && DIELECTRIC_BITE=0
    DIELECTRIC_BITE=$((DIELECTRIC_BITE * DIELECTRIC_BITE_GAIN))

    # Control = irrigation imbalance + stored tunnel resistance + active bite
    FIELD_CONTROL=$((FIELD_IMBALANCE + DIELECTRIC_CHARGE + DIELECTRIC_BITE))
    FIELD_CONTROL="$(clamp "$FIELD_CONTROL" 0 "$FIELD_MAX")"

    NEW_UP=$((BULK_UP_BASE - FIELD_CONTROL * UP_TRIM_PER_CONTROL))
    NEW_DOWN=$((BULK_DOWN_BASE - FIELD_CONTROL * DOWN_TRIM_PER_CONTROL))

    TARGET_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    TARGET_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    # Viscosity: tunnel control seeps into effect
    CUR_BULK_UP="$(approach_target "$CUR_BULK_UP" "$TARGET_UP" "$MAX_UP_STEP")"
    CUR_BULK_DOWN="$(approach_target "$CUR_BULK_DOWN" "$TARGET_DOWN" "$MAX_DOWN_STEP")"

    apply_rates

    LAST_DIELECTRIC_CHARGE="$DIELECTRIC_CHARGE"

    sleep "$SLEEP_SEC"
done