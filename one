#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"
GAME_CLASS="1:15"

SLEEP_SEC=1

BASE_GAME_UP=8500
BASE_GAME_DOWN=12000

MAX_GAME_UP=15000
MAX_GAME_DOWN=20000
MIN_GAME_UP=5000
MIN_GAME_DOWN=8000

# Core controller
BOOST=0
AVG_DELTA=0

FACTOR=180
BASE_PULSE=300
MAX_BOOST=3000

MEMORY_NUM=8
MEMORY_DEN=10

# Vegas/CoDel-style persistence filter
DEFICIT_DEADBAND=2
PERSIST_REQUIRED=3
RECOVER_REQUIRED=3

BAD_COUNT=0
GOOD_COUNT=0

# Event-triggered apply
APPLY_THRESHOLD=400
LAST_APPLIED_UP=0
LAST_APPLIED_DOWN=0

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

absdiff() {
    A="$1"
    B="$2"
    D=$((A - B))
    [ "$D" -lt 0 ] && D=$((0 - D))
    echo "$D"
}

LAST_TOTAL=0
SEEDED=0

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    # Seed first sample so startup does not create fake huge delta
    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        echo "seed total=$TOTAL"
        sleep "$SLEEP_SEC"
        continue
    fi

    DELTA=$((TOTAL - LAST_TOTAL))

    # Counter reset protection
    if [ "$DELTA" -lt 0 ]; then
        DELTA=0
        AVG_DELTA=0
        BAD_COUNT=0
        GOOD_COUNT=0
        echo "counter-reset detected total=$TOTAL last=$LAST_TOTAL"
    fi

    # expected cadence memory
    AVG_DELTA=$(((AVG_DELTA * 7 + DELTA * 3) / 10))

    # Vegas-style expected vs actual gap
    DEFICIT=$((AVG_DELTA - DELTA))
    [ "$DEFICIT" -lt 0 ] && DEFICIT=0

    # Deadband: tiny mismatch is noise, not obligation
    if [ "$DEFICIT" -le "$DEFICIT_DEADBAND" ]; then
        EFFECTIVE_DEFICIT=0
    else
        EFFECTIVE_DEFICIT="$DEFICIT"
    fi

    # CoDel-style persistence: badness must persist
    if [ "$EFFECTIVE_DEFICIT" -gt 0 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        BAD_COUNT=0
    fi

    # Decide target pressure
    if [ "$BAD_COUNT" -ge "$PERSIST_REQUIRED" ]; then
        SIGNAL=$((EFFECTIVE_DEFICIT + 2))
        TARGET=$((BASE_PULSE + SIGNAL * FACTOR))
        MODE="authority-hold"
    elif [ "$GOOD_COUNT" -ge "$RECOVER_REQUIRED" ]; then
        SIGNAL=1
        TARGET=$((BASE_PULSE + SIGNAL * FACTOR))
        MODE="release"
    else
        SIGNAL=2
        TARGET=$((BASE_PULSE + SIGNAL * FACTOR))
        MODE="warm"
    fi

    # Continuous low-cost correction
    BOOST=$(((BOOST * MEMORY_NUM + TARGET * (MEMORY_DEN - MEMORY_NUM)) / MEMORY_DEN))

    [ "$BOOST" -lt 0 ] && BOOST=0
    [ "$BOOST" -gt "$MAX_BOOST" ] && BOOST="$MAX_BOOST"

    DESIRED_UP=$((BASE_GAME_UP + BOOST))
    DESIRED_DOWN=$((BASE_GAME_DOWN + BOOST))

    [ "$DESIRED_UP" -lt "$MIN_GAME_UP" ] && DESIRED_UP="$MIN_GAME_UP"
    [ "$DESIRED_DOWN" -lt "$MIN_GAME_DOWN" ] && DESIRED_DOWN="$MIN_GAME_DOWN"

    [ "$DESIRED_UP" -gt "$MAX_GAME_UP" ] && DESIRED_UP="$MAX_GAME_UP"
    [ "$DESIRED_DOWN" -gt "$MAX_GAME_DOWN" ] && DESIRED_DOWN="$MAX_GAME_DOWN"

    UP_DIFF="$(absdiff "$DESIRED_UP" "$LAST_APPLIED_UP")"
    DOWN_DIFF="$(absdiff "$DESIRED_DOWN" "$LAST_APPLIED_DOWN")"

    SHOULD_APPLY=0
    if [ "$LAST_APPLIED_UP" -eq 0 ] || [ "$LAST_APPLIED_DOWN" -eq 0 ]; then
        SHOULD_APPLY=1
    elif [ "$UP_DIFF" -ge "$APPLY_THRESHOLD" ] || [ "$DOWN_DIFF" -ge "$APPLY_THRESHOLD" ]; then
        SHOULD_APPLY=1
    fi

    echo "delta=$DELTA avg=$AVG_DELTA deficit=$DEFICIT eff=$EFFECTIVE_DEFICIT bad=$BAD_COUNT good=$GOOD_COUNT mode=$MODE target=$TARGET boost=$BOOST up=$DESIRED_UP down=$DESIRED_DOWN apply=$SHOULD_APPLY"

    if [ "$SHOULD_APPLY" -eq 1 ]; then
        if has_class "$WAN_DEV" "$GAME_CLASS"; then
            tc class change dev "$WAN_DEV" classid "$GAME_CLASS" \
                hfsc ls rate "${DESIRED_UP}kbit" ul rate "${DESIRED_UP}kbit"
        fi

        if has_class "$IFB_DEV" "$GAME_CLASS"; then
            tc class change dev "$IFB_DEV" classid "$GAME_CLASS" \
                hfsc ls rate "${DESIRED_DOWN}kbit" ul rate "${DESIRED_DOWN}kbit"
        fi

        LAST_APPLIED_UP="$DESIRED_UP"
        LAST_APPLIED_DOWN="$DESIRED_DOWN"
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
