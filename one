#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

# Sacred game lane
GAME_UP=12000
GAME_DOWN=16000

# Bulk states
BULK_UP_GREEN=45000
BULK_DOWN_GREEN=90000

BULK_UP_YELLOW=32000
BULK_DOWN_YELLOW=65000

BULK_UP_RED=22000
BULK_DOWN_RED=45000

# Rare panic clamp
BULK_UP_PANIC=14000
BULK_DOWN_PANIC=28000

AVG_DELTA=0
LAST_TOTAL=0
SEEDED=0

DROP_DEADBAND=180
SPIKE_DEADBAND=150

PANIC_DROP=900
PANIC_SPIKE=1200

YELLOW_REQUIRED=6
RED_REQUIRED=18
PANIC_REQUIRED=3
GREEN_REQUIRED=20

SPIKE_CONFIRM=3
DROP_CONFIRM=2

SPIKE_COUNT=0
DROP_COUNT=0
BAD_COUNT=0
GOOD_COUNT=0
PANIC_COUNT=0

MODE_DWELL_REQUIRED=1
MODE_DWELL=0

LAST_MODE="none"

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    if has_class "$DEV" "$CLASS"; then
        tc class change dev "$DEV" classid "$CLASS" \
            hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit"
    else
        echo "WARN missing class dev=$DEV class=$CLASS"
    fi
}

apply_mode() {
    MODE="$1"

    case "$MODE" in
        green)
            BULK_UP="$BULK_UP_GREEN"
            BULK_DOWN="$BULK_DOWN_GREEN"
            ;;
        yellow)
            BULK_UP="$BULK_UP_YELLOW"
            BULK_DOWN="$BULK_DOWN_YELLOW"
            ;;
        red)
            BULK_UP="$BULK_UP_RED"
            BULK_DOWN="$BULK_DOWN_RED"
            ;;
        panic)
            BULK_UP="$BULK_UP_PANIC"
            BULK_DOWN="$BULK_DOWN_PANIC"
            ;;
        *)
            echo "WARN unknown mode=$MODE"
            return
            ;;
    esac

    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$BULK_DOWN"

    echo "APPLY mode=$MODE game=${GAME_UP}/${GAME_DOWN} bulk=${BULK_UP}/${BULK_DOWN}"
}

next_mode_graph() {
    CURRENT="$1"
    PRESSURE="$2"

    # PRESSURE:
    # 0 = clean
    # 1 = yellow requested
    # 2 = red requested
    # 3 = panic requested

    case "$CURRENT" in
        green)
            case "$PRESSURE" in
                0) echo "green" ;;
                1|2|3) echo "yellow" ;;   # green cannot jump straight to red/panic
            esac
            ;;

        yellow)
            case "$PRESSURE" in
                0) echo "green" ;;
                1) echo "yellow" ;;
                2|3) echo "red" ;;        # yellow escalates to red first
            esac
            ;;

        red)
            case "$PRESSURE" in
                0) echo "yellow" ;;       # red must step down through yellow
                1) echo "yellow" ;;
                2) echo "red" ;;
                3) echo "panic" ;;
            esac
            ;;

        panic)
            case "$PRESSURE" in
                0|1) echo "red" ;;        # panic cannot jump straight green
                2) echo "red" ;;
                3) echo "panic" ;;
            esac
            ;;

        *)
            echo "green"
            ;;
    esac
}

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        LAST_MODE="green"
        apply_mode green
        echo "seed total=$TOTAL"
        sleep "$SLEEP_SEC"
        continue
    fi

    DELTA=$((TOTAL - LAST_TOTAL))

    if [ "$DELTA" -lt 0 ]; then
        DELTA=0
        AVG_DELTA=0
        BAD_COUNT=0
        GOOD_COUNT=0
        PANIC_COUNT=0
        SPIKE_COUNT=0
        DROP_COUNT=0
        MODE_DWELL=0
        echo "counter-reset detected"
    fi

    OLD_AVG="$AVG_DELTA"
    AVG_DELTA=$(((AVG_DELTA * 85 + DELTA * 15) / 100))

    DROP=$((OLD_AVG - DELTA))
    [ "$DROP" -lt 0 ] && DROP=0

    SPIKE=$((DELTA - OLD_AVG))
    [ "$SPIKE" -lt 0 ] && SPIKE=0

    if [ "$SPIKE" -gt "$SPIKE_DEADBAND" ]; then
        SPIKE_COUNT=$((SPIKE_COUNT + 1))
    else
        [ "$SPIKE_COUNT" -gt 0 ] && SPIKE_COUNT=$((SPIKE_COUNT - 1))
    fi

    if [ "$DROP" -gt "$DROP_DEADBAND" ]; then
        DROP_COUNT=$((DROP_COUNT + 1))
    else
        [ "$DROP_COUNT" -gt 0 ] && DROP_COUNT=$((DROP_COUNT - 1))
    fi

    BAD=0
    PANIC=0
    REASON="clean"

    if [ "$SPIKE_COUNT" -ge "$SPIKE_CONFIRM" ]; then
        BAD=1
        REASON="spike_persist"
    fi

    if [ "$DROP_COUNT" -ge "$DROP_CONFIRM" ]; then
        BAD=1
        REASON="drop_persist"
    fi

    if [ "$SPIKE" -gt "$PANIC_SPIKE" ]; then
        PANIC=1
        REASON="panic_spike"
    fi

    if [ "$DROP" -gt "$PANIC_DROP" ]; then
        PANIC=1
        REASON="panic_drop"
    fi

    if [ "$PANIC" -eq 1 ]; then
        PANIC_COUNT=$((PANIC_COUNT + 1))
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
    elif [ "$BAD" -eq 1 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        PANIC_COUNT=0
        GOOD_COUNT=0
    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        BAD_COUNT=0
        PANIC_COUNT=0
    fi

    PRESSURE=0

    if [ "$GOOD_COUNT" -ge "$GREEN_REQUIRED" ]; then
        PRESSURE=0
    fi

    if [ "$BAD_COUNT" -ge "$YELLOW_REQUIRED" ]; then
        PRESSURE=1
    fi

    if [ "$BAD_COUNT" -ge "$RED_REQUIRED" ]; then
        PRESSURE=2
    fi

    if [ "$PANIC_COUNT" -ge "$PANIC_REQUIRED" ]; then
        PRESSURE=3
    fi

    MODE="$(next_mode_graph "$LAST_MODE" "$PRESSURE")"

    MODE_DWELL=$((MODE_DWELL + 1))

    echo "delta=$DELTA avg=$AVG_DELTA drop=$DROP spike=$SPIKE spike_count=$SPIKE_COUNT drop_count=$DROP_COUNT reason=$REASON bad=$BAD_COUNT panic=$PANIC_COUNT good=$GOOD_COUNT pressure=$PRESSURE from=$LAST_MODE to=$MODE"

    if [ "$MODE" != "$LAST_MODE" ] && [ "$MODE_DWELL" -ge "$MODE_DWELL_REQUIRED" ]; then
        apply_mode "$MODE"
        LAST_MODE="$MODE"
        MODE_DWELL=0
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
