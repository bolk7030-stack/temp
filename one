#!/bin/sh

# =========================================================
# NEXT-GEN FLOW / CURVATURE CONTROLLER
#
# Goal:
# - preserve honest acceleration
# - absorb ugly transitions
# - avoid artificial steel
# - preserve micro reachability
# - reduce sticky opponent feel
#
# Philosophy:
# "Do not punish motion.
#  Punish unstable curvature."
# =========================================================

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

# ---------------------------------------------------------
# Sacred game lane
# ---------------------------------------------------------

GAME_UP=12000
GAME_DOWN=16000

# ---------------------------------------------------------
# Bulk states
# ---------------------------------------------------------

# Free movement
BULK_UP_GREEN=45000
BULK_DOWN_GREEN=90000

# Jolt absorption
BULK_UP_YELLOW=36000
BULK_DOWN_YELLOW=78000

# Structural defense posture
BULK_UP_RED=28000
BULK_DOWN_RED=62000

# Panic = same as red (no violent clamp)
BULK_UP_PANIC=28000
BULK_DOWN_PANIC=62000

# ---------------------------------------------------------
# Core memory
# ---------------------------------------------------------

AVG_DELTA=0
LAST_TOTAL=0
SEEDED=0

OLD_DELTA=0
OLD_CURVE=0

# ---------------------------------------------------------
# Thresholds
# ---------------------------------------------------------

SPIKE_DEADBAND=150
DROP_DEADBAND=180

# NEW:
# jerk = unstable acceleration curvature
JERK_DEADBAND=120

PANIC_SPIKE=1200
PANIC_DROP=900
PANIC_JERK=500

# ---------------------------------------------------------
# State persistence
# ---------------------------------------------------------

YELLOW_REQUIRED=7
RED_REQUIRED=24
PANIC_REQUIRED=3
GREEN_REQUIRED=12

SPIKE_CONFIRM=2
DROP_CONFIRM=2
JERK_CONFIRM=2

SPIKE_COUNT=0
DROP_COUNT=0
JERK_COUNT=0

BAD_COUNT=0
GOOD_COUNT=0
PANIC_COUNT=0

MODE_DWELL_REQUIRED=1
MODE_DWELL=0

LAST_MODE="none"

DEBUG=1

# =========================================================
# LOGGING
# =========================================================

log() {
    [ "$DEBUG" -eq 1 ] && echo "$1"
}

# =========================================================
# TC HELPERS
# =========================================================

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    if has_class "$DEV" "$CLASS"; then
        tc class change dev "$DEV" classid "$CLASS" \
            hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit"
    fi
}

# =========================================================
# MODE APPLICATION
# =========================================================

apply_mode() {
    MODE="$1"

    case "$MODE" in
        green)
            BULK_UP="$BULK_UP_GREEN"
            BULK_DOWN="$BULK_DOWN_GREEN"
            ;;
        yellow)
            BULK_UP="$BULK_UP_YELLOW"
            BULK_DOWN="$BULK_DOWN_YELLOW"
            ;;
        red)
            BULK_UP="$BULK_UP_RED"
            BULK_DOWN="$BULK_DOWN_RED"
            ;;
        panic)
            BULK_UP="$BULK_UP_PANIC"
            BULK_DOWN="$BULK_DOWN_PANIC"
            ;;
        *)
            return
            ;;
    esac

    # Sacred lane
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    # Bulk absorber
    apply_class "$WAN_DEV" "$BULK_CLASS" "$BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$BULK_DOWN"

    log "APPLY mode=$MODE game=${GAME_UP}/${GAME_DOWN} bulk=${BULK_UP}/${BULK_DOWN}"
}

# =========================================================
# MAIN LOOP
# =========================================================

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        LAST_MODE="green"
        apply_mode green

        log "seed total=$TOTAL"

        sleep "$SLEEP_SEC"
        continue
    fi

    # -----------------------------------------------------
    # Core delta
    # -----------------------------------------------------

    DELTA=$((TOTAL - LAST_TOTAL))

    if [ "$DELTA" -lt 0 ]; then
        DELTA=0
    fi

    # -----------------------------------------------------
    # Stable memory
    # -----------------------------------------------------

    OLD_AVG="$AVG_DELTA"

    AVG_DELTA=$(((AVG_DELTA * 85 + DELTA * 15) / 100))

    # -----------------------------------------------------
    # Standard spike/drop
    # -----------------------------------------------------

    DROP=$((OLD_AVG - DELTA))
    [ "$DROP" -lt 0 ] && DROP=0

    SPIKE=$((DELTA - OLD_AVG))
    [ "$SPIKE" -lt 0 ] && SPIKE=0

    # -----------------------------------------------------
    # NEXT-GEN CURVATURE
    # -----------------------------------------------------

    CURVE=$((DELTA - OLD_DELTA))

    JERK=$((CURVE - OLD_CURVE))

    # absolute jerk
    if [ "$JERK" -lt 0 ]; then
        JERK=$((0 - JERK))
    fi

    # -----------------------------------------------------
    # SENSOR COUNTS
    # -----------------------------------------------------

    if [ "$SPIKE" -gt "$SPIKE_DEADBAND" ]; then
        SPIKE_COUNT=$((SPIKE_COUNT + 1))
    else
        [ "$SPIKE_COUNT" -gt 0 ] && SPIKE_COUNT=$((SPIKE_COUNT - 1))
    fi

    if [ "$DROP" -gt "$DROP_DEADBAND" ]; then
        DROP_COUNT=$((DROP_COUNT + 1))
    else
        [ "$DROP_COUNT" -gt 0 ] && DROP_COUNT=$((DROP_COUNT - 1))
    fi

    # NEW:
    # punish ugly transition curvature
    if [ "$JERK" -gt "$JERK_DEADBAND" ]; then
        JERK_COUNT=$((JERK_COUNT + 1))
    else
        [ "$JERK_COUNT" -gt 0 ] && JERK_COUNT=$((JERK_COUNT - 1))
    fi

    # -----------------------------------------------------
    # CLASSIFICATION
    # -----------------------------------------------------

    BAD=0
    PANIC=0
    REASON="clean"

    if [ "$SPIKE_COUNT" -ge "$SPIKE_CONFIRM" ]; then
        BAD=1
        REASON="spike"
    fi

    if [ "$DROP_COUNT" -ge "$DROP_CONFIRM" ]; then
        BAD=1
        REASON="drop"
    fi

    # NEW:
    # unstable acceleration curvature
    if [ "$JERK_COUNT" -ge "$JERK_CONFIRM" ]; then
        BAD=1
        REASON="jerk"
    fi

    # -----------------------------------------------------
    # PANIC
    # -----------------------------------------------------

    if [ "$SPIKE" -gt "$PANIC_SPIKE" ]; then
        PANIC=1
        REASON="panic_spike"
    fi

    if [ "$DROP" -gt "$PANIC_DROP" ]; then
        PANIC=1
        REASON="panic_drop"
    fi

    if [ "$JERK" -gt "$PANIC_JERK" ]; then
        PANIC=1
        REASON="panic_jerk"
    fi

    # -----------------------------------------------------
    # STATE MEMORY
    # -----------------------------------------------------

    if [ "$PANIC" -eq 1 ]; then
        PANIC_COUNT=$((PANIC_COUNT + 1))
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0

    elif [ "$BAD" -eq 1 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
        PANIC_COUNT=0

    else
        GOOD_COUNT=$((GOOD_COUNT + 1))

        # instability evaporates faster
        [ "$BAD_COUNT" -gt 0 ] && BAD_COUNT=$((BAD_COUNT - 1))

        PANIC_COUNT=0
    fi

    # -----------------------------------------------------
    # MODE
    # -----------------------------------------------------

    MODE="$LAST_MODE"

    if [ "$PANIC_COUNT" -ge "$PANIC_REQUIRED" ]; then
        MODE="panic"

    elif [ "$BAD_COUNT" -ge "$RED_REQUIRED" ]; then
        MODE="red"

    elif [ "$BAD_COUNT" -ge "$YELLOW_REQUIRED" ]; then
        MODE="yellow"

    elif [ "$GOOD_COUNT" -ge "$GREEN_REQUIRED" ]; then
        MODE="green"
    fi

    MODE_DWELL=$((MODE_DWELL + 1))

    # -----------------------------------------------------
    # LOGGING
    # -----------------------------------------------------

    log "delta=$DELTA avg=$AVG_DELTA spike=$SPIKE drop=$DROP jerk=$JERK reason=$REASON bad=$BAD_COUNT good=$GOOD_COUNT mode=$MODE"

    # -----------------------------------------------------
    # APPLY
    # -----------------------------------------------------

    if [ "$MODE" != "$LAST_MODE" ] && \
       [ "$MODE_DWELL" -ge "$MODE_DWELL_REQUIRED" ]; then

        apply_mode "$MODE"

        LAST_MODE="$MODE"
        MODE_DWELL=0
    fi

    # -----------------------------------------------------
    # MEMORY UPDATE
    # -----------------------------------------------------

    OLD_DELTA="$DELTA"
    OLD_CURVE="$CURVE"

    LAST_TOTAL="$TOTAL"

    sleep "$SLEEP_SEC"
done
