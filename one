#!/bin/sh
# phase-auto.sh -- find the best egress phase delay, then HOLD it as a soft,
# living offset (small correlated jitter) instead of a flat wall -- and quietly
# re-attach to the live phase over time so the feel stays continuous.
#
# Working assumption (yours): response-delay is bimodal (~7ms fast / ~22ms slow,
# ~15ms apart => ~60Hz tick). Goal: keep response mass in the fast (<=14ms)
# region, with an offset that feels like natural timing, not a fixed step.
#
# What's new in this version:
#   - The held delay is "Dms JITTERms CORR% distribution normal" -- a soft,
#     correlated, bell-shaped offset that gently breathes instead of a flat value.
#     Continuity in the VALUE itself. (knob: JITTER_MS, kept small on purpose.)
#   - HOLD phase is a quiet self-checking loop: every CHECK_SEC it re-measures
#     fast-fraction and, only if it has drifted past a deadband, nudges the
#     center one step toward whatever reads better. Subtle re-attachment, no
#     fidgeting, no hard mode switches.
#
# HONEST TRADEOFF: every ms of jitter spends a little phase precision. JITTER_MS
# is deliberately tiny. The loop watches fast-fraction so you can confirm the
# continuity didn't cost the alignment.
#
# Touches ONLY console game UDP (src 192.168.10.50 port 3659) on eth1 egress.
# Tears down cleanly on exit.
#
# Usage:
#   sh phase-auto.sh                 # sweep, pick best, hold as living offset
#   sh phase-auto.sh "0 4 8 12 16"   # custom candidate delays
#   sh phase-auto.sh hold 9          # skip sweep, hold 9ms living offset
#   survive disconnect: setsid sh phase-auto.sh &

WAN_DEV="eth1"
HOST="192.168.10.50"
CONSOLE_PORT="3659"
PKTS=200

# --- continuity knobs ---
JITTER_MS=1          # soft breathing around the center (keep small: 0-2)
CORR_PCT=70          # correlation % -> consecutive delays related = smooth drift
CHECK_SEC=45         # how often the hold loop re-measures phase
DEADBAND=8           # only nudge if fast-fraction drifts more than this many %
NUDGE_MS=3           # step size when re-attaching
MIN_D=0; MAX_D=18    # bounds for the drifting center

cleanup() {
    echo >&2
    echo "tearing down egress shaper on $WAN_DEV ..." >&2
    tc qdisc del dev "$WAN_DEV" root 2>/dev/null
    echo "done. $WAN_DEV restored to default." >&2
}
trap 'cleanup; exit 0' INT TERM

ensure_netem() {
    if tc qdisc add dev "$WAN_DEV" root handle 99: netem delay 1ms 2>/dev/null; then
        tc qdisc del dev "$WAN_DEV" root 2>/dev/null; echo "netem: available" >&2; return 0
    fi
    echo "netem: installing kmod-sched-netem ..." >&2
    if command -v apk >/dev/null 2>&1; then apk update >/dev/null 2>&1; apk add kmod-sched-netem >/dev/null 2>&1
    elif command -v opkg >/dev/null 2>&1; then opkg update >/dev/null 2>&1; opkg install kmod-sched-netem >/dev/null 2>&1
    else echo "ERROR: no apk/opkg." >&2; return 1; fi
    if tc qdisc add dev "$WAN_DEV" root handle 99: netem delay 1ms 2>/dev/null; then
        tc qdisc del dev "$WAN_DEV" root 2>/dev/null; echo "netem: installed OK" >&2; return 0
    fi
    echo "ERROR: netem still unavailable." >&2; return 1
}

# build shaper. D>0 uses a LIVING offset: center D, jitter, correlation, normal dist.
build_delay() {
    D="$1"
    tc qdisc del dev "$WAN_DEV" root 2>/dev/null
    tc qdisc add dev "$WAN_DEV" root handle 1: prio bands 3 || return 1
    if [ "$D" -gt 0 ]; then
        if [ "$JITTER_MS" -gt 0 ]; then
            # soft, correlated, bell-shaped offset -- the "continuous" feel
            tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: netem \
                delay "${D}ms" "${JITTER_MS}ms" "${CORR_PCT}%" distribution normal || \
            tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: netem delay "${D}ms" "${JITTER_MS}ms" || return 1
        else
            tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: netem delay "${D}ms" || return 1
        fi
    else
        tc qdisc add dev "$WAN_DEV" parent 1:2 handle 20: pfifo || return 1
    fi
    tc qdisc add dev "$WAN_DEV" parent 1:1 handle 10: pfifo 2>/dev/null
    tc qdisc add dev "$WAN_DEV" parent 1:3 handle 30: pfifo 2>/dev/null
    tc filter add dev "$WAN_DEV" parent 1: protocol ip prio 1 u32 \
        match ip src "${HOST}/32" match ip sport "$CONSOLE_PORT" 0xffff flowid 1:2 || return 1
    return 0
}

measure_fastfrac() {
    RAW="/tmp/auto-raw-$$.txt"
    tcpdump -n -tt -c "$PKTS" -i br-lan \
        host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
        2>/dev/null > "$RAW"
    awk -v HOST="$HOST" '
    function islocal(ip){ return (ip ~ /^192\.168\./ || ip ~ /^239\./ || ip ~ /^224\./ || ip ~ /^255\./) }
    { t=$1+0; src=$3; dst=$5; sub(/:$/,"",dst)
      split(src,sa,"."); si=sa[1]"."sa[2]"."sa[3]"."sa[4]
      split(dst,da,"."); di=da[1]"."da[2]"."da[3]"."da[4]
      if (si==HOST){o=di;out=1} else if(di==HOST){o=si;out=0} else next
      if (islocal(o)) next
      if (out){lo=t} else if(lo>0){rd=(t-lo)*1000; if(rd>=0&&rd<200){rc++; if(rd<=14)f++}} }
    END{ if(rc<10) print -1; else print int(f*100/rc) }' "$RAW"
    rm -f "$RAW"
}

# quiet self-checking hold: keep the living offset, re-attach when phase drifts.
hold_loop() {
    CENTER="$1"
    echo "HOLDING living offset: center=${CENTER}ms jitter=${JITTER_MS}ms corr=${CORR_PCT}% (normal)" >&2
    echo "re-checking every ${CHECK_SEC}s; nudging only past ${DEADBAND}% drift. Ctrl-C to revert." >&2
    LASTF=""
    while true; do
        sleep "$CHECK_SEC"
        F="$(measure_fastfrac)"
        [ "$F" -lt 0 ] && { echo "  (no game pairs right now; holding ${CENTER}ms)" >&2; continue; }
        if [ -z "$LASTF" ]; then LASTF="$F"; echo "  baseline fast-fraction ${F}% @ ${CENTER}ms" >&2; continue; fi
        DROP=$(( LASTF - F ))
        if [ "$DROP" -le "$DEADBAND" ]; then
            echo "  steady (${F}% @ ${CENTER}ms) -- no change" >&2
            [ "$F" -gt "$LASTF" ] && LASTF="$F"
            continue
        fi
        # drifted: try one step each way, keep whichever reads best
        echo "  drift detected (${F}% < ${LASTF}%); re-attaching ..." >&2
        BESTD="$CENTER"; BESTF="$F"
        UP=$(( CENTER + NUDGE_MS )); DN=$(( CENTER - NUDGE_MS ))
        if [ "$UP" -le "$MAX_D" ]; then build_delay "$UP"; sleep 2; FU="$(measure_fastfrac)"
            [ "$FU" -ge 0 ] && [ "$FU" -gt "$BESTF" ] && { BESTF="$FU"; BESTD="$UP"; }; fi
        if [ "$DN" -ge "$MIN_D" ]; then build_delay "$DN"; sleep 2; FD="$(measure_fastfrac)"
            [ "$FD" -ge 0 ] && [ "$FD" -gt "$BESTF" ] && { BESTF="$FD"; BESTD="$DN"; }; fi
        CENTER="$BESTD"; build_delay "$CENTER"; LASTF="$BESTF"
        echo "  re-attached -> center=${CENTER}ms (${BESTF}%)" >&2
    done
}

# ===================== MAIN =====================
if [ "$1" = "hold" ]; then
    ensure_netem || exit 1
    D="${2:-9}"
    build_delay "$D" || { echo "build failed"; cleanup; exit 1; }
    hold_loop "$D"
fi

case "$1" in
    *" "* ) CANDIDATES="$1" ;;
    * ) CANDIDATES="0 3 6 9 12" ;;
esac

ensure_netem || exit 1
echo "=== PHASE SWEEP (play continuously) ===" >&2
echo "candidates: $CANDIDATES ms | ${PKTS} pkts each" >&2

BEST_D=0; BEST_F=-1
for D in $CANDIDATES; do
    build_delay "$D" || { echo "build failed at ${D}ms"; cleanup; exit 1; }
    sleep 2
    F="$(measure_fastfrac)"
    if [ "$F" -lt 0 ]; then echo "  ${D}ms -> too few pairs (keep playing)" >&2
    else echo "  ${D}ms -> FAST-FRACTION ${F}%" >&2
        [ "$F" -gt "$BEST_F" ] && { BEST_F="$F"; BEST_D="$D"; }; fi
done

echo >&2
if [ "$BEST_F" -lt 0 ]; then echo "No usable measurements. In a live match?" >&2; cleanup; exit 1; fi
echo "BEST: ${BEST_D}ms gave ${BEST_F}% fast." >&2

if [ "$BEST_D" -eq 0 ]; then
    echo "0ms was best -> egress delay doesn't improve phase here. Reverting." >&2
    cleanup; exit 0
fi

build_delay "$BEST_D" || { echo "apply failed"; cleanup; exit 1; }
hold_loop "$BEST_D"
