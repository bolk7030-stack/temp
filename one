#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

BULK_UP_BASE=45000
BULK_DOWN_BASE=90000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

TARGET_DELAY_MS=12

# Directional trim strength
UP_TRIM_PER_DEBT=450
DOWN_TRIM_PER_DEBT=700

# Directional pressure debt
UP_DEBT=0
DOWN_DEBT=0
DEBT_MAX=60
DEBT_DECAY_PER_TICK=3

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY wan=${WAN_DELAY}ms ifb=${IFB_DELAY}ms up_debt=$UP_DEBT down_debt=$DOWN_DEBT game=${GAME_UP}/${GAME_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    WAN_EXCESS=$((WAN_DELAY - TARGET_DELAY_MS))
    IFB_EXCESS=$((IFB_DELAY - TARGET_DELAY_MS))

    if [ "$WAN_EXCESS" -gt 0 ]; then
        UP_DEBT=$((UP_DEBT + WAN_EXCESS))
    else
        UP_DEBT=$((UP_DEBT - DEBT_DECAY_PER_TICK))
    fi

    if [ "$IFB_EXCESS" -gt 0 ]; then
        DOWN_DEBT=$((DOWN_DEBT + IFB_EXCESS))
    else
        DOWN_DEBT=$((DOWN_DEBT - DEBT_DECAY_PER_TICK))
    fi

    UP_DEBT="$(clamp "$UP_DEBT" 0 "$DEBT_MAX")"
    DOWN_DEBT="$(clamp "$DOWN_DEBT" 0 "$DEBT_MAX")"

    NEW_UP=$((BULK_UP_BASE - UP_DEBT * UP_TRIM_PER_DEBT))
    NEW_DOWN=$((BULK_DOWN_BASE - DOWN_DEBT * DOWN_TRIM_PER_DEBT))

    CUR_BULK_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    CUR_BULK_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    apply_rates

    sleep "$SLEEP_SEC"
done