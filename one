#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:13"
BULK_CLASS="1:12"

SLEEP_SEC=1

# Sacred game lane
GAME_UP=12000
GAME_DOWN=16000

# Bulk states: softer than panic script
BULK_UP_GREEN=45000
BULK_DOWN_GREEN=90000

BULK_UP_YELLOW=32000
BULK_DOWN_YELLOW=65000

BULK_UP_RED=22000
BULK_DOWN_RED=45000

# Panic exists, but should rarely trigger
BULK_UP_PANIC=14000
BULK_DOWN_PANIC=28000

AVG_DELTA=0
LAST_TOTAL=0
SEEDED=0

# Wider noise gates for 11v11
DROP_DEADBAND=220
SPIKE_DEADBAND=350

# Panic only for violent disruption
PANIC_DROP=900
PANIC_SPIKE=1200

# Slower state transitions
YELLOW_REQUIRED=6
RED_REQUIRED=14
PANIC_REQUIRED=3
GREEN_REQUIRED=35

BAD_COUNT=0
GOOD_COUNT=0
PANIC_COUNT=0
LAST_MODE="none"

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    if has_class "$DEV" "$CLASS"; then
        tc class change dev "$DEV" classid "$CLASS" \
            hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit"
    else
        echo "WARN missing class dev=$DEV class=$CLASS"
    fi
}

apply_mode() {
    MODE="$1"

    case "$MODE" in
        green)
            BULK_UP="$BULK_UP_GREEN"
            BULK_DOWN="$BULK_DOWN_GREEN"
            ;;
        yellow)
            BULK_UP="$BULK_UP_YELLOW"
            BULK_DOWN="$BULK_DOWN_YELLOW"
            ;;
        red)
            BULK_UP="$BULK_UP_RED"
            BULK_DOWN="$BULK_DOWN_RED"
            ;;
        panic)
            BULK_UP="$BULK_UP_PANIC"
            BULK_DOWN="$BULK_DOWN_PANIC"
            ;;
        *)
            echo "WARN unknown mode=$MODE"
            return
            ;;
    esac

    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$BULK_DOWN"

    echo "APPLY mode=$MODE game=${GAME_UP}/${GAME_DOWN} bulk=${BULK_UP}/${BULK_DOWN}"
}

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        LAST_MODE="green"
        apply_mode green
        echo "seed total=$TOTAL"
        sleep "$SLEEP_SEC"
        continue
    fi

    DELTA=$((TOTAL - LAST_TOTAL))

    if [ "$DELTA" -lt 0 ]; then
        DELTA=0
        AVG_DELTA=0
        BAD_COUNT=0
        GOOD_COUNT=0
        PANIC_COUNT=0
        echo "counter-reset detected"
    fi

    OLD_AVG="$AVG_DELTA"

    # Slower memory for 11s continuity
    AVG_DELTA=$(((AVG_DELTA * 85 + DELTA * 15) / 100))

    DROP=$((OLD_AVG - DELTA))
    [ "$DROP" -lt 0 ] && DROP=0

    SPIKE=$((DELTA - OLD_AVG))
    [ "$SPIKE" -lt 0 ] && SPIKE=0

    BAD=0
    PANIC=0
    REASON="clean"

    if [ "$DROP" -gt "$DROP_DEADBAND" ]; then
        BAD=1
        REASON="drop"
    fi

    if [ "$SPIKE" -gt "$SPIKE_DEADBAND" ]; then
        BAD=1
        REASON="spike"
    fi

    if [ "$DROP" -gt "$PANIC_DROP" ]; then
        PANIC=1
        REASON="panic_drop"
    fi

    if [ "$SPIKE" -gt "$PANIC_SPIKE" ]; then
        PANIC=1
        REASON="panic_spike"
    fi

    if [ "$PANIC" -eq 1 ]; then
        PANIC_COUNT=$((PANIC_COUNT + 1))
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
    elif [ "$BAD" -eq 1 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        PANIC_COUNT=0
        GOOD_COUNT=0
    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        BAD_COUNT=0
        PANIC_COUNT=0
    fi

    MODE="$LAST_MODE"

    if [ "$PANIC_COUNT" -ge "$PANIC_REQUIRED" ]; then
        MODE="panic"
    elif [ "$BAD_COUNT" -ge "$RED_REQUIRED" ]; then
        MODE="red"
    elif [ "$BAD_COUNT" -ge "$YELLOW_REQUIRED" ]; then
        MODE="yellow"
    elif [ "$GOOD_COUNT" -ge "$GREEN_REQUIRED" ]; then
        MODE="green"
    fi

    echo "delta=$DELTA avg=$AVG_DELTA drop=$DROP spike=$SPIKE reason=$REASON bad_count=$BAD_COUNT panic_count=$PANIC_COUNT good_count=$GOOD_COUNT mode=$MODE"

    if [ "$MODE" != "$LAST_MODE" ]; then
        apply_mode "$MODE"
        LAST_MODE="$MODE"
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
