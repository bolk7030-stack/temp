#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

SLEEP_SEC=1

GAME_UP=12000
GAME_DOWN=16000

BULK_UP_GREEN=45000
BULK_DOWN_GREEN=90000

BULK_UP_YELLOW=34000
BULK_DOWN_YELLOW=70000

BULK_UP_RED=24000
BULK_DOWN_RED=52000

# Queue-delay thresholds in ms
YELLOW_DELAY_MS=12
RED_DELAY_MS=25

YELLOW_REQUIRED=3
RED_REQUIRED=6
GREEN_REQUIRED=8

BAD_COUNT=0
GOOD_COUNT=0
LAST_MODE="none"

get_delay_ms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    print int(val)
                    exit
                }
            }
        }
    '
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_mode() {
    MODE="$1"

    case "$MODE" in
        green)
            BULK_UP="$BULK_UP_GREEN"
            BULK_DOWN="$BULK_DOWN_GREEN"
            ;;
        yellow)
            BULK_UP="$BULK_UP_YELLOW"
            BULK_DOWN="$BULK_DOWN_YELLOW"
            ;;
        red)
            BULK_UP="$BULK_UP_RED"
            BULK_DOWN="$BULK_DOWN_RED"
            ;;
        *)
            return
            ;;
    esac

    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$BULK_DOWN"

    echo "APPLY mode=$MODE game=${GAME_UP}/${GAME_DOWN} bulk=${BULK_UP}/${BULK_DOWN}"
}

while true
do
    WAN_DELAY="$(get_delay_ms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_ms "$IFB_DEV")"

    [ -z "$WAN_DELAY" ] && WAN_DELAY=0
    [ -z "$IFB_DELAY" ] && IFB_DELAY=0

    # Use worst local queue delay
    if [ "$WAN_DELAY" -gt "$IFB_DELAY" ]; then
        DELAY="$WAN_DELAY"
        SIDE="wan"
    else
        DELAY="$IFB_DELAY"
        SIDE="ifb"
    fi

    PRESSURE=0

    if [ "$DELAY" -ge "$YELLOW_DELAY_MS" ]; then
        PRESSURE=1
    fi

    if [ "$DELAY" -ge "$RED_DELAY_MS" ]; then
        PRESSURE=2
    fi

    if [ "$PRESSURE" -gt 0 ]; then
        BAD_COUNT=$((BAD_COUNT + 1))
        GOOD_COUNT=0
    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        BAD_COUNT=0
    fi

    MODE="$LAST_MODE"

    if [ "$BAD_COUNT" -ge "$RED_REQUIRED" ] && [ "$PRESSURE" -eq 2 ]; then
        MODE="red"
    elif [ "$BAD_COUNT" -ge "$YELLOW_REQUIRED" ]; then
        MODE="yellow"
    elif [ "$GOOD_COUNT" -ge "$GREEN_REQUIRED" ]; then
        MODE="green"
    fi

    echo "delay=${DELAY}ms side=$SIDE wan=${WAN_DELAY}ms ifb=${IFB_DELAY}ms pressure=$PRESSURE bad=$BAD_COUNT good=$GOOD_COUNT mode=$MODE"

    if [ "$MODE" != "$LAST_MODE" ]; then
        apply_mode "$MODE"
        LAST_MODE="$MODE"
    fi

    sleep "$SLEEP_SEC"
done