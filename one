#!/bin/sh

PING_TARGET="1.1.1.1"

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

WAN_CLASS="1:1"
IFB_CLASS="1:1"

BASE_UP=85000
BASE_DOWN=120000

MIN_UP=55000
MIN_DOWN=85000

MAX_UP=85000
MAX_DOWN=120000

DROP_PER_MS=750
SLEEP_SEC=2

SMOOTH_JITTER=0

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

get_ping_jitter() {
    OUT="$(ping -c 5 -q "$PING_TARGET" 2>/dev/null)"
    RTT_LINE="$(echo "$OUT" | grep -E 'round-trip|rtt')"

    [ -z "$RTT_LINE" ] && echo "" && return

    NUMS="$(echo "$RTT_LINE" | sed 's/.*= //' | sed 's/ ms//')"

    MIN="$(echo "$NUMS" | cut -d/ -f1 | cut -d. -f1)"
    MAX="$(echo "$NUMS" | cut -d/ -f3 | cut -d. -f1)"

    [ -z "$MIN" ] && echo "" && return
    [ -z "$MAX" ] && echo "" && return

    echo $((MAX - MIN))
}

while true
do
    JITTER="$(get_ping_jitter)"

    [ -z "$JITTER" ] && echo "ping parse failed" && sleep "$SLEEP_SEC" && continue

    # Microburst-style memory:
    # jumps up fast, decays gradually
    if [ "$JITTER" -gt "$SMOOTH_JITTER" ]; then
        SMOOTH_JITTER="$JITTER"
    else
        SMOOTH_JITTER=$(( (SMOOTH_JITTER + JITTER) / 2 ))
    fi

    EFFECTIVE_JITTER="$SMOOTH_JITTER"

    NEW_UP=$((BASE_UP - (EFFECTIVE_JITTER * DROP_PER_MS)))
    NEW_DOWN=$((BASE_DOWN - (EFFECTIVE_JITTER * DROP_PER_MS)))

    [ "$NEW_UP" -lt "$MIN_UP" ] && NEW_UP="$MIN_UP"
    [ "$NEW_DOWN" -lt "$MIN_DOWN" ] && NEW_DOWN="$MIN_DOWN"

    [ "$NEW_UP" -gt "$MAX_UP" ] && NEW_UP="$MAX_UP"
    [ "$NEW_DOWN" -gt "$MAX_DOWN" ] && NEW_DOWN="$MAX_DOWN"

    echo "raw_jitter=${JITTER}ms effective=${EFFECTIVE_JITTER}ms up=${NEW_UP}kbit down=${NEW_DOWN}kbit"

    if has_class "$WAN_DEV" "$WAN_CLASS"; then
        tc class change dev "$WAN_DEV" classid "$WAN_CLASS" \
            hfsc sc rate "${NEW_UP}kbit" ul rate "${NEW_UP}kbit"
    else
        echo "skip WAN"
    fi

    if has_class "$IFB_DEV" "$IFB_CLASS"; then
        tc class change dev "$IFB_DEV" classid "$IFB_CLASS" \
            hfsc sc rate "${NEW_DOWN}kbit" ul rate "${NEW_DOWN}kbit"
    else
        echo "skip IFB"
    fi

    sleep "$SLEEP_SEC"
done
