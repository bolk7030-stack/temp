#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

WAN_CLASS="1:1"
IFB_CLASS="1:1"

BASE_UP=85000
BASE_DOWN=120000

MIN_UP=55000
MIN_DOWN=85000

MAX_UP=85000
MAX_DOWN=120000

DROP_PER_BACKLOG=500   # kbit drop per queued packet
SLEEP_SEC=2

SMOOTH_PRESSURE=0

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

get_backlog_packets() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /backlog/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /^[0-9]+p$/) {
                    gsub("p","",$i)
                    print $i
                    exit
                }
            }
        }
    '
}

while true
do
    WAN_BACKLOG="$(get_backlog_packets "$WAN_DEV")"
    IFB_BACKLOG="$(get_backlog_packets "$IFB_DEV")"

    [ -z "$WAN_BACKLOG" ] && WAN_BACKLOG=0
    [ -z "$IFB_BACKLOG" ] && IFB_BACKLOG=0

    # Use the worse side as pressure
    if [ "$IFB_BACKLOG" -gt "$WAN_BACKLOG" ]; then
        PRESSURE="$IFB_BACKLOG"
    else
        PRESSURE="$WAN_BACKLOG"
    fi

    # Microburst memory:
    # pressure jumps up fast, decays gradually
    if [ "$PRESSURE" -gt "$SMOOTH_PRESSURE" ]; then
        SMOOTH_PRESSURE="$PRESSURE"
    else
        SMOOTH_PRESSURE=$(( (SMOOTH_PRESSURE + PRESSURE) / 2 ))
    fi

    NEW_UP=$((BASE_UP - (SMOOTH_PRESSURE * DROP_PER_BACKLOG)))
    NEW_DOWN=$((BASE_DOWN - (SMOOTH_PRESSURE * DROP_PER_BACKLOG)))

    [ "$NEW_UP" -lt "$MIN_UP" ] && NEW_UP="$MIN_UP"
    [ "$NEW_DOWN" -lt "$MIN_DOWN" ] && NEW_DOWN="$MIN_DOWN"

    [ "$NEW_UP" -gt "$MAX_UP" ] && NEW_UP="$MAX_UP"
    [ "$NEW_DOWN" -gt "$MAX_DOWN" ] && NEW_DOWN="$MAX_DOWN"

    echo "wan_backlog=${WAN_BACKLOG}p ifb_backlog=${IFB_BACKLOG}p pressure=${SMOOTH_PRESSURE} up=${NEW_UP}kbit down=${NEW_DOWN}kbit"

    if has_class "$WAN_DEV" "$WAN_CLASS"; then
        tc class change dev "$WAN_DEV" classid "$WAN_CLASS" \
            hfsc sc rate "${NEW_UP}kbit" ul rate "${NEW_UP}kbit"
    else
        echo "skip WAN"
    fi

    if has_class "$IFB_DEV" "$IFB_CLASS"; then
        tc class change dev "$IFB_DEV" classid "$IFB_CLASS" \
            hfsc sc rate "${NEW_DOWN}kbit" ul rate "${NEW_DOWN}kbit"
    else
        echo "skip IFB"
    fi

    sleep "$SLEEP_SEC"
done
