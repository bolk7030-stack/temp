#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"

GAME_CLASS="1:20"
BULK_CLASS="1:60"

# Faster sensing than 1 Hz
SLEEP_SEC=0.2

GAME_UP=12000
GAME_DOWN=16000

# Standing reservation: already owns some field before pressure arrives
BULK_UP_BASE=42000
BULK_DOWN_BASE=84000

BULK_UP_MIN=24000
BULK_DOWN_MIN=52000

# deci-ms target: 12.0ms = 120
TARGET_DELAY_DMS=120

# P-dominant control
P_GAIN_NUM=1
P_GAIN_DEN=10

# Small leaky integral
I_DEBT=0
I_DEBT_MAX=30
I_GAIN_NUM=1
I_GAIN_DEN=30
I_LEAK_NUM=92
I_LEAK_DEN=100

# Smooth shared pressure field
FIELD=0
FIELD_SMOOTH_NUM=6
FIELD_SMOOTH_DEN=10

# Trim strength per control unit
UP_TRIM_PER_CONTROL=450
DOWN_TRIM_PER_CONTROL=700

# Actuator continuity
MAX_UP_STEP=2500
MAX_DOWN_STEP=4500

CUR_BULK_UP="$BULK_UP_BASE"
CUR_BULK_DOWN="$BULK_DOWN_BASE"

LAST_WAN_DELAY=0
LAST_IFB_DELAY=0

get_delay_dms() {
    DEV="$1"

    tc -s qdisc show dev "$DEV" 2>/dev/null | awk '
        /avg_delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /avg_delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    printf "%d\n", int((val * 10) + 0.5)
                    exit
                }
            }
        }
        /delay/ {
            for (i=1; i<=NF; i++) {
                if ($i ~ /delay/) {
                    val=$(i+1)
                    gsub(/[^0-9.]/, "", val)
                    printf "%d\n", int((val * 10) + 0.5)
                    exit
                }
            }
        }
    '
}

clamp() {
    VAL="$1"
    MIN="$2"
    MAX="$3"

    [ "$VAL" -lt "$MIN" ] && VAL="$MIN"
    [ "$VAL" -gt "$MAX" ] && VAL="$MAX"

    echo "$VAL"
}

approach_target() {
    CURRENT="$1"
    TARGET="$2"
    STEP="$3"

    if [ "$CURRENT" -lt "$TARGET" ]; then
        CURRENT=$((CURRENT + STEP))
        [ "$CURRENT" -gt "$TARGET" ] && CURRENT="$TARGET"
    elif [ "$CURRENT" -gt "$TARGET" ]; then
        CURRENT=$((CURRENT - STEP))
        [ "$CURRENT" -lt "$TARGET" ] && CURRENT="$TARGET"
    fi

    echo "$CURRENT"
}

apply_class() {
    DEV="$1"
    CLASS="$2"
    RATE="$3"

    tc class change dev "$DEV" classid "$CLASS" \
        hfsc ls rate "${RATE}kbit" ul rate "${RATE}kbit" 2>/dev/null
}

apply_rates() {
    apply_class "$WAN_DEV" "$GAME_CLASS" "$GAME_UP"
    apply_class "$IFB_DEV" "$GAME_CLASS" "$GAME_DOWN"

    apply_class "$WAN_DEV" "$BULK_CLASS" "$CUR_BULK_UP"
    apply_class "$IFB_DEV" "$BULK_CLASS" "$CUR_BULK_DOWN"

    echo "APPLY wan=${WAN_DELAY}dms ifb=${IFB_DELAY}dms excess=${FIELD_EXCESS} field=$FIELD p=$P_CONTROL i=$I_DEBT control=$CONTROL target=${TARGET_UP}/${TARGET_DOWN} bulk=${CUR_BULK_UP}/${CUR_BULK_DOWN}"
}

apply_rates

while true
do
    WAN_DELAY="$(get_delay_dms "$WAN_DEV")"
    IFB_DELAY="$(get_delay_dms "$IFB_DEV")"

    # Missing read = hold last value, not fake clean zero
    [ -z "$WAN_DELAY" ] && WAN_DELAY="$LAST_WAN_DELAY"
    [ -z "$IFB_DELAY" ] && IFB_DELAY="$LAST_IFB_DELAY"

    LAST_WAN_DELAY="$WAN_DELAY"
    LAST_IFB_DELAY="$IFB_DELAY"

    WAN_EXCESS=$((WAN_DELAY - TARGET_DELAY_DMS))
    IFB_EXCESS=$((IFB_DELAY - TARGET_DELAY_DMS))

    [ "$WAN_EXCESS" -lt 0 ] && WAN_EXCESS=0
    [ "$IFB_EXCESS" -lt 0 ] && IFB_EXCESS=0

    if [ "$WAN_EXCESS" -gt "$IFB_EXCESS" ]; then
        MAX_EXCESS="$WAN_EXCESS"
        MIN_EXCESS="$IFB_EXCESS"
    else
        MAX_EXCESS="$IFB_EXCESS"
        MIN_EXCESS="$WAN_EXCESS"
    fi

    # Smooth shared-field combine:
    # mostly worst side, but shared pressure matters.
    FIELD_EXCESS=$(((MAX_EXCESS * 3 + MIN_EXCESS) / 4))

    # Sensor smoothing: irrigation becomes just one clean shared field
    FIELD=$(((FIELD * FIELD_SMOOTH_NUM + FIELD_EXCESS * (FIELD_SMOOTH_DEN - FIELD_SMOOTH_NUM)) / FIELD_SMOOTH_DEN))

    # P term: instant authority from current field
    P_CONTROL=$((FIELD * P_GAIN_NUM / P_GAIN_DEN))

    # Leaky I term: small persistence without windup
    I_DEBT=$((I_DEBT * I_LEAK_NUM / I_LEAK_DEN))

    if [ "$FIELD" -gt 0 ]; then
        I_DEBT=$((I_DEBT + FIELD * I_GAIN_NUM / I_GAIN_DEN))
    fi

    I_DEBT="$(clamp "$I_DEBT" 0 "$I_DEBT_MAX")"

    CONTROL=$((P_CONTROL + I_DEBT))
    CONTROL="$(clamp "$CONTROL" 0 60)"

    NEW_UP=$((BULK_UP_BASE - CONTROL * UP_TRIM_PER_CONTROL))
    NEW_DOWN=$((BULK_DOWN_BASE - CONTROL * DOWN_TRIM_PER_CONTROL))

    TARGET_UP="$(clamp "$NEW_UP" "$BULK_UP_MIN" "$BULK_UP_BASE")"
    TARGET_DOWN="$(clamp "$NEW_DOWN" "$BULK_DOWN_MIN" "$BULK_DOWN_BASE")"

    CUR_BULK_UP="$(approach_target "$CUR_BULK_UP" "$TARGET_UP" "$MAX_UP_STEP")"
    CUR_BULK_DOWN="$(approach_target "$CUR_BULK_DOWN" "$TARGET_DOWN" "$MAX_DOWN_STEP")"

    apply_rates

    sleep "$SLEEP_SEC"
done