#!/bin/sh
# game-dscp.sh -- impose a CONSISTENT priority mark on the game flow, replacing
# the game's own flaky marking (the sensor scan saw CS3 on ~half the packets one
# run, almost nothing the next -- not dependable). This stamps ALL the console's
# game UDP with a reliable DSCP, then (optionally) prioritises it.
#
# Non-interfering: it does NOT delay or reorder anything. It only sets the DSCP
# byte so downstream queues (and CAKE, if you enable it) can treat the flow as
# priority. Zero added latency. Only matters under load -- but it's set-and-forget.
#
# HONEST SCOPE: only affects the SERVER-bound half. conntrack showed your game is
# partly PEER-TO-PEER (residential dst IPs); those paths leave your control after
# eth1 regardless. This marks everything consistently anyway -- can't hurt.
#
# Mark used: CS4 (0x80 tos / DSCP 0x20 '32') -- a real-time/interactive class,
# one step above the game's own CS3, widely honoured by CAKE diffserv4 as the
# latency tier. Change MARK below if you prefer EF.
#
# Touches ONLY console game UDP (src 192.168.10.50 port 3659).
# Uses nftables (OpenWrt 25.x default). Reverts cleanly.
#
# Usage:
#   sh game-dscp.sh on      # apply consistent mark (persists until 'off' or reboot)
#   sh game-dscp.sh off     # remove it
#   sh game-dscp.sh status  # show whether it's active + live mark counts

HOST="192.168.10.50"
GAMEPORT="3659"
WAN="eth1"
TABLE="inet gamedscp"
MARK="cs4"          # cs4=interactive. alternatives: ef, cs3, cs5

apply() {
    # build a tiny dedicated nft table so we never touch the main firewall
    nft add table inet gamedscp 2>/dev/null
    nft 'add chain inet gamedscp postrouting { type filter hook postrouting priority mangle ; policy accept ; }' 2>/dev/null
    # flush our chain so re-running is idempotent
    nft flush chain inet gamedscp postrouting 2>/dev/null
    # stamp DSCP on the console's outbound game UDP
    nft add rule inet gamedscp postrouting ip saddr "$HOST" udp sport "$GAMEPORT" ip dscp set "$MARK" counter 2>/dev/null \
        || { echo "nft rule failed (is nftables present? 'nft --version')"; return 1; }
    echo "applied: console game UDP (${HOST}:${GAMEPORT}) -> DSCP ${MARK}, consistently."
    echo "non-interfering: no delay, no reorder. only re-classifies."
    return 0
}

remove() {
    nft delete table inet gamedscp 2>/dev/null && echo "removed: game DSCP marking gone." \
        || echo "nothing to remove (not active)."
}

status() {
    echo "== game-dscp status =="
    if nft list table inet gamedscp >/dev/null 2>&1; then
        echo "ACTIVE. rule + live packet counter:"
        nft list table inet gamedscp 2>/dev/null | grep -E 'dscp set|counter' | sed 's/^/   /'
        echo
        echo "verify on the wire (run during a match):"
        echo "  tcpdump -n -v -c 20 -i $WAN host $HOST and udp 2>/dev/null | grep -o 'tos 0x[0-9a-f]*' | sort | uniq -c"
        echo "  -> you should now see a CONSISTENT mark (cs4 = tos 0x80) on egress."
    else
        echo "NOT active. (run: sh game-dscp.sh on)"
    fi
}

case "$1" in
    on|apply|"" ) apply ;;
    off|remove )  remove ;;
    status )      status ;;
    * ) echo "usage: sh game-dscp.sh [on|off|status]"; exit 1 ;;
esac

# reminder about the bigger picture, printed after on/off
if [ "$1" = "on" ] || [ "$1" = "apply" ] || [ -z "$1" ]; then
    echo
    echo "NOTE: this is the latency-free, set-and-forget lever the sensor sweep"
    echo "left standing. It only bites UNDER LOAD (your backlog reads 0 idle) and"
    echo "only on the server-bound half (peer-to-peer paths leave your control)."
    echo "To make it actually do work under load, the downstream queue must honour"
    echo "DSCP -- i.e. enable qosmate/CAKE with diffserv4. Without that, the mark"
    echo "is set but nothing acts on it yet. Say the word and we wire that next."
fi
