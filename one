#!/bin/sh
# arb-probe.sh (v2) -- multi-flow ARBITRATION ordering probe. HANG-PROOF.
# v1 hung waiting for packets. v2 captures with a hard wall-clock cap using a
# background tcpdump + kill, writes to a file, then analyses. It ALWAYS stops.
#
# Measures how your simultaneous peer flows are ordered against each other at
# egress (eth1, post-scheduler): per-peer share, who-leaves-first at contest
# instants, and adjacency. Interpretation-free.
#
# Usage:
#   sh arb-probe.sh            # capture ~12s of egress game traffic, analyse
#   sh arb-probe.sh 20         # capture for 20 seconds instead
#
# Run during a CONTESTED match (several peers active) for meaningful results.

HOST="192.168.10.50"
WAN="eth1"
SECS="${1:-12}"           # capture duration in seconds (NOT a packet count)
WINDOW=3                  # ms: packets within this = same contest instant
RAW="/tmp/arb-raw-$$.txt"

echo "Capturing ${SECS}s of egress game traffic on $WAN ... PLAY a contested match." >&2

# background tcpdump, hard-kill after SECS no matter what. No packet count to wait on.
tcpdump -n -tt -i "$WAN" \
    host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
    2>/dev/null > "$RAW" &
TPID=$!
# countdown so it can't outlive SECS even if tcpdump ignores signals briefly
i=0
while [ "$i" -lt "$SECS" ]; do
    sleep 1
    kill -0 "$TPID" 2>/dev/null || break
    i=$((i+1))
done
kill "$TPID" 2>/dev/null
sleep 1
kill -9 "$TPID" 2>/dev/null    # force if still alive
wait "$TPID" 2>/dev/null

LN=$(wc -l < "$RAW" 2>/dev/null)
echo "captured ${LN:-0} packets in ${SECS}s" >&2
if [ "${LN:-0}" -lt 40 ]; then
    echo "Too few egress packets. Either not in an active match, or outbound peer" >&2
    echo "traffic is sparse (itself a hint: peers rarely race -> little arbitration)." >&2
    echo "Try a longer capture during heavy action: sh arb-probe.sh 25" >&2
    rm -f "$RAW"; exit 1
fi

awk -v HOST="$HOST" -v WINDOW="$WINDOW" '
{
    t=$1+0; src=$3; dst=$5; sub(/:$/,"",dst)
    split(src,sa,"."); si=sa[1]"."sa[2]"."sa[3]"."sa[4]
    split(dst,da,"."); di=da[1]"."da[2]"."da[3]"."da[4]
    if (si!=HOST) next
    if (di ~ /^192\.168\./ || di ~ /^239\./ || di ~ /^224\./ || di ~ /^255\./) next
    n++; T[n]=t; P[n]=di
    if (!(di in seen)){ seen[di]=1; order[++np]=di }
    cnt[di]++
}
END{
    if (n < 30){ print "  too few outbound game packets ("n")"; exit }
    printf "\n  === %d outbound game packets across %d peers ===\n", n, np

    print "\n  1. PER-PEER SHARE:"
    for (i=1;i<=np;i++){
        p=order[i]; pct=cnt[p]*100/n
        bar=""; k=int(pct/2); while(k-->0)bar=bar"#"
        printf "     %-16s |%-30s %d (%.1f%%)\n", p, bar, cnt[p], pct
    }

    print "\n  2. FIRST-OUT AT CONTEST INSTANTS (<= " WINDOW "ms apart):"
    instants=0
    for (i=2;i<=n;i++){
        gap=(T[i]-T[i-1])*1000
        if (gap>=0 && gap<=WINDOW && P[i]!=P[i-1]){ firstout[P[i-1]]++; instants++ }
    }
    if (instants<5){
        print "     only " instants " contested instants -- peers rarely race."
        print "     arbitration barely exercised: sparse-but-isolated, likely fine."
    } else {
        for (i=1;i<=np;i++){
            p=order[i]; w=firstout[p]+0; pct=w*100/instants
            bar=""; k=int(pct/2); while(k-->0)bar=bar"#"
            printf "     %-16s |%-30s %d wins (%.1f%%)\n", p, bar, w, pct
        }
        printf "     total contested instants: %d\n", instants
        print "     FAIR = each peer win-share ~ its traffic-share above."
        print "     One peer winning FAR off its share = arbitration bias (a lever)."
    }

    print "\n  3. ADJACENCY:"
    same=0; diff=0
    for (i=2;i<=n;i++){ if(P[i]==P[i-1]) same++; else diff++ }
    tot=same+diff
    if (tot>0){
        printf "     same-peer back-to-back: %.1f%%   peer-alternation: %.1f%%\n", same*100/tot, diff*100/tot
        print  "     high alternation = round-robin-like; high back-to-back = per-peer bursts."
    }

    print "\n  interpretation-free: ordering counts only. run 2-3x; real bias reproduces."
}
' "$RAW"
rm -f "$RAW"
