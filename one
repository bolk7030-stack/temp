#!/bin/sh

WAN_DEV="eth1"
IFB_DEV="ifb-eth1"
GAME_CLASS="1:15"

SLEEP_SEC=1

BASE_GAME_UP=8500
BASE_GAME_DOWN=12000

MAX_GAME_UP=15000
MAX_GAME_DOWN=20000
MIN_GAME_UP=5000
MIN_GAME_DOWN=8000

# GREEN controller
BOOST=700
AVG_DELTA=0

BASE_PULSE=700
FACTOR=160
MAX_BOOST=3500

# Attack fast, release slow
ATTACK_NUM=5
ATTACK_DEN=10

RELEASE_NUM=9
RELEASE_DEN=10

DEFICIT_DEADBAND=2
RISE_DEADBAND=3

RECOVER_REQUIRED=7
GOOD_COUNT=0

# asymmetric apply
APPLY_UP_THRESHOLD=150
APPLY_DOWN_THRESHOLD=800

LAST_APPLIED_UP=0
LAST_APPLIED_DOWN=0

get_pkts() {
    DEV="$1"
    CLASS="$2"

    tc -s class show dev "$DEV" 2>/dev/null | awk -v cls="$CLASS" '
        $0 ~ "class hfsc " cls {
            found=1
            next
        }
        found && /Sent/ {
            for (i=1; i<=NF; i++) {
                if ($i == "pkt") {
                    print $(i-1)
                    exit
                }
            }
        }
    '
}

has_class() {
    tc class show dev "$1" 2>/dev/null | grep -q "class hfsc $2"
}

absdiff() {
    A="$1"
    B="$2"
    D=$((A - B))
    [ "$D" -lt 0 ] && D=$((0 - D))
    echo "$D"
}

LAST_TOTAL=0
SEEDED=0

while true
do
    WAN_PKTS="$(get_pkts "$WAN_DEV" "$GAME_CLASS")"
    IFB_PKTS="$(get_pkts "$IFB_DEV" "$GAME_CLASS")"

    [ -z "$WAN_PKTS" ] && WAN_PKTS=0
    [ -z "$IFB_PKTS" ] && IFB_PKTS=0

    TOTAL=$((WAN_PKTS + IFB_PKTS))

    if [ "$SEEDED" -eq 0 ]; then
        LAST_TOTAL="$TOTAL"
        SEEDED=1
        echo "seed total=$TOTAL"
        sleep "$SLEEP_SEC"
        continue
    fi

    DELTA=$((TOTAL - LAST_TOTAL))

    if [ "$DELTA" -lt 0 ]; then
        DELTA=0
        AVG_DELTA=0
        GOOD_COUNT=0
        echo "counter-reset detected total=$TOTAL last=$LAST_TOTAL"
    fi

    OLD_AVG="$AVG_DELTA"
    AVG_DELTA=$(((AVG_DELTA * 7 + DELTA * 3) / 10))

    DEFICIT=$((AVG_DELTA - DELTA))
    [ "$DEFICIT" -lt 0 ] && DEFICIT=0

    RISE=$((DELTA - OLD_AVG))
    [ "$RISE" -lt 0 ] && RISE=0

    if [ "$DEFICIT" -le "$DEFICIT_DEADBAND" ]; then
        EFFECTIVE_DEFICIT=0
    else
        EFFECTIVE_DEFICIT="$DEFICIT"
    fi

    if [ "$RISE" -le "$RISE_DEADBAND" ]; then
        EFFECTIVE_RISE=0
    else
        EFFECTIVE_RISE="$RISE"
    fi

    # GREEN LOGIC:
    # rising packet demand = go now
    # deficit = recover now
    if [ "$EFFECTIVE_RISE" -gt 0 ]; then
        SIGNAL=$((EFFECTIVE_RISE + 3))
        TARGET=$((BASE_PULSE + SIGNAL * FACTOR))
        MODE="green-attack"
        GOOD_COUNT=0

        BOOST=$(((BOOST * ATTACK_NUM + TARGET * (ATTACK_DEN - ATTACK_NUM)) / ATTACK_DEN))

    elif [ "$EFFECTIVE_DEFICIT" -gt 0 ]; then
        SIGNAL=$((EFFECTIVE_DEFICIT + 3))
        TARGET=$((BASE_PULSE + SIGNAL * FACTOR))
        MODE="green-reclaim"
        GOOD_COUNT=0

        BOOST=$(((BOOST * ATTACK_NUM + TARGET * (ATTACK_DEN - ATTACK_NUM)) / ATTACK_DEN))

    else
        GOOD_COUNT=$((GOOD_COUNT + 1))
        TARGET="$BASE_PULSE"

        if [ "$GOOD_COUNT" -ge "$RECOVER_REQUIRED" ]; then
            MODE="slow-release"
            BOOST=$(((BOOST * RELEASE_NUM + TARGET * (RELEASE_DEN - RELEASE_NUM)) / RELEASE_DEN))
        else
            MODE="hold-green"
        fi
    fi

    [ "$BOOST" -lt 700 ] && BOOST=700
    [ "$BOOST" -gt "$MAX_BOOST" ] && BOOST="$MAX_BOOST"

    DESIRED_UP=$((BASE_GAME_UP + BOOST))
    DESIRED_DOWN=$((BASE_GAME_DOWN + BOOST))

    [ "$DESIRED_UP" -lt "$MIN_GAME_UP" ] && DESIRED_UP="$MIN_GAME_UP"
    [ "$DESIRED_DOWN" -lt "$MIN_GAME_DOWN" ] && DESIRED_DOWN="$MIN_GAME_DOWN"

    [ "$DESIRED_UP" -gt "$MAX_GAME_UP" ] && DESIRED_UP="$MAX_GAME_UP"
    [ "$DESIRED_DOWN" -gt "$MAX_GAME_DOWN" ] && DESIRED_DOWN="$MAX_GAME_DOWN"

    UP_DIFF="$(absdiff "$DESIRED_UP" "$LAST_APPLIED_UP")"
    DOWN_DIFF="$(absdiff "$DESIRED_DOWN" "$LAST_APPLIED_DOWN")"

    SHOULD_APPLY=0

    if [ "$LAST_APPLIED_UP" -eq 0 ] || [ "$LAST_APPLIED_DOWN" -eq 0 ]; then
        SHOULD_APPLY=1
    elif [ "$DESIRED_UP" -gt "$LAST_APPLIED_UP" ] && [ "$UP_DIFF" -ge "$APPLY_UP_THRESHOLD" ]; then
        SHOULD_APPLY=1
    elif [ "$DESIRED_DOWN" -gt "$LAST_APPLIED_DOWN" ] && [ "$DOWN_DIFF" -ge "$APPLY_UP_THRESHOLD" ]; then
        SHOULD_APPLY=1
    elif [ "$DESIRED_UP" -lt "$LAST_APPLIED_UP" ] && [ "$UP_DIFF" -ge "$APPLY_DOWN_THRESHOLD" ]; then
        SHOULD_APPLY=1
    elif [ "$DESIRED_DOWN" -lt "$LAST_APPLIED_DOWN" ] && [ "$DOWN_DIFF" -ge "$APPLY_DOWN_THRESHOLD" ]; then
        SHOULD_APPLY=1
    fi

    echo "delta=$DELTA avg=$AVG_DELTA rise=$EFFECTIVE_RISE deficit=$EFFECTIVE_DEFICIT good=$GOOD_COUNT mode=$MODE target=$TARGET boost=$BOOST up=$DESIRED_UP down=$DESIRED_DOWN apply=$SHOULD_APPLY"

    if [ "$SHOULD_APPLY" -eq 1 ]; then
        if has_class "$WAN_DEV" "$GAME_CLASS"; then
            tc class change dev "$WAN_DEV" classid "$GAME_CLASS" \
                hfsc ls rate "${DESIRED_UP}kbit" ul rate "${DESIRED_UP}kbit"
        fi

        if has_class "$IFB_DEV" "$GAME_CLASS"; then
            tc class change dev "$IFB_DEV" classid "$GAME_CLASS" \
                hfsc ls rate "${DESIRED_DOWN}kbit" ul rate "${DESIRED_DOWN}kbit"
        fi

        LAST_APPLIED_UP="$DESIRED_UP"
        LAST_APPLIED_DOWN="$DESIRED_DOWN"
    fi

    LAST_TOTAL="$TOTAL"
    sleep "$SLEEP_SEC"
done
