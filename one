#!/bin/sh
# phase-probe.sh -- READ-ONLY phase probe (v4).
#
# v3 bugs (found by auditing against your known-good command):
#   1. I QUOTED the filter as one argument; your working command passed it as
#      separate unquoted words. busybox tcpdump parses these differently and the
#      quoted blob compiled to a filter matching nothing.
#   2. I added a 5th clause ("and not port 5353"); your working filter had 4.
#      The longer chain silently compiled to match-nothing on busybox.
# Fix: reproduce your EXACT working invocation, filter unquoted, 4 clauses.
# Keep -tt (absolute epoch) -- verified to parse cleanly; awk computes deltas.
#
# Usage: sh phase-probe.sh [count]   (default 400)

HOST="192.168.10.50"
COUNT="${1:-400}"
RAW="/tmp/phase-raw-$$.txt"

echo "Capturing $COUNT UDP packets for $HOST (br-lan) ..." >&2
echo "  -> PLAY NOW." >&2

# Filter passed UNQUOTED as separate words (matches your working command).
# Exactly 4 'and' clauses, same as the command you confirmed works.
tcpdump -n -tt -c "$COUNT" -i br-lan \
    host "$HOST" and udp and not port 9999 and not port 1900 and not port 53 \
    2>/dev/null > "$RAW"

LINES=$(wc -l < "$RAW" 2>/dev/null)
echo "captured ${LINES:-0} packets" >&2
if [ "${LINES:-0}" -lt 20 ]; then
    echo "Too few. Run the known-good command by hand to confirm traffic:" >&2
    echo "  tcpdump -n -ttt -c 60 -i br-lan host $HOST and udp and not port 9999 and not port 1900 and not port 53" >&2
    rm -f "$RAW"; exit 1
fi

awk -v HOST="$HOST" '
function islocal(ip){ return (ip ~ /^192\.168\./ || ip ~ /^239\./ || ip ~ /^224\./ || ip ~ /^255\./) }
{
    t=$1+0
    src=$3; dst=$5; sub(/:$/,"",dst)
    split(src,sa,"."); srcip=sa[1]"."sa[2]"."sa[3]"."sa[4]
    split(dst,da,"."); dstip=da[1]"."da[2]"."da[3]"."da[4]
    if (srcip==HOST) { dir="OUT"; otherip=dstip }
    else if (dstip==HOST) { dir="IN"; otherip=srcip }
    else next
    if (islocal(otherip)) next

    kept++
    if (dir=="OUT") {
        no++
        if (lastout>0){ g=(t-lastout)*1000; if(g>0&&g<500){oc++;osum+=g;ogap[oc]=g;if(omin==""||g<omin)omin=g;if(g>omax)omax=g} }
        lastout=t
    } else {
        ni++
        if (lastin>0){ g=(t-lastin)*1000; if(g>0&&g<500){ic++;isum+=g;igap[ic]=g;if(imin==""||g<imin)imin=g;if(g>imax)imax=g} }
        lastin=t
        if (lastout>0){ rd=(t-lastout)*1000; if(rd>=0&&rd<500){rc++;rsum+=rd;rdel[rc]=rd} }
    }
}
END{
    if(kept<10){ print "  too few remote-server packets ("kept") -- match may be all-P2P/local."; exit }
    printf "\n  (kept %d remote game-server packets)\n\n", kept
    print "==== OUTBOUND cadence (console -> server) ===="
    if(oc>0){ om=osum/oc; for(i=1;i<=oc;i++){d=ogap[i]-om;oss+=d*d}osd=sqrt(oss/oc)
        printf "  pkts:%d mean:%.2fms min/max:%.2f/%.2f jitter:%.2fms\n",no,om,omin,omax,osd } else print "  (none)"
    print "\n==== INBOUND cadence (server -> console) ===="
    if(ic>0){ im=isum/ic; for(i=1;i<=ic;i++){d=igap[i]-im;iss+=d*d}isd=sqrt(iss/ic)
        printf "  pkts:%d mean:%.2fms min/max:%.2f/%.2f jitter:%.2fms\n",ni,im,imin,imax,isd } else print "  (none)"
    print "\n==== RESPONSE DELAY (OUT -> next IN) : the PHASE signal ===="
    if(rc>0){ rm=rsum/rc
        for(i=1;i<=rc;i++){ b=int(rdel[i]/5); h[b]++; if(b>maxb)maxb=b }
        printf "  samples:%d mean:%.2fms\n  distribution (5ms buckets):\n",rc,rm
        for(b=0;b<=maxb;b++){ if(h[b]>0){ bar="";k=h[b];while(k-->0&&length(bar)<50)bar=bar"#"
            printf "   %3d-%3dms | %-50s %d\n",b*5,(b*5)+4,bar,h[b] } }
        print "\n  READING: one peak = stable phase; two+ peaks = phase target,"
        print "           peak spacing ~ remote tick period."
    } else print "  (no OUT->IN pairs)"
    print ""
}
' "$RAW"
rm -f "$RAW"
