#!/bin/sh
# phase-pacer.sh -- wire the game flow into NFQUEUE and run the REAL phase pacer
# (phase-pacer.py), which folds outbound packets by INFERRED TICK PHASE from the
# inbound stream -- the honest "fold by incoming, not by count" version.
#
# Requires: python3, python3-netfilterqueue. Installs attempt via apk/opkg.
#
# Usage:
#   sh phase-pacer.sh on     # wire nft -> NFQUEUE, launch pacer (watch the lock!)
#   sh phase-pacer.sh off    # tear down
#
# WATCH THE OUTPUT: it prints tick-lock quality every 5s. If lock stays <0.4,
# inbound is a smear -> there's no stable tick -> the pacer correctly DOESN'T fold,
# and that's your answer that the phase isn't real. If lock is high (>0.6) and
# stable, the phase is real and the pacer is genuinely folding slow-phase packets.

HOST="192.168.10.50"; GP="3659"; QNUM=0
TABLE="phasepacer"

deps(){
    if python3 -c "import netfilterqueue" 2>/dev/null; then return 0; fi
    echo "installing python3-netfilterqueue ..." >&2
    command -v apk >/dev/null 2>&1 && apk add python3-netfilterqueue python3 >/dev/null 2>&1
    command -v opkg >/dev/null 2>&1 && opkg update >/dev/null 2>&1 && opkg install python3-netfilterqueue python3 >/dev/null 2>&1
    python3 -c "import netfilterqueue" 2>/dev/null
}

wire(){
    nft delete table inet "$TABLE" 2>/dev/null
    nft add table inet "$TABLE" || return 1
    nft "add chain inet $TABLE q { type filter hook postrouting priority mangle ; policy accept ; }" || return 1
    # enqueue BOTH directions of the game flow to NFQUEUE so the pacer sees inbound+outbound
    nft add rule inet "$TABLE" q ip saddr "$HOST" udp sport "$GP" queue num "$QNUM" bypass 2>/dev/null
    nft add rule inet "$TABLE" q ip daddr "$HOST" udp dport "$GP" queue num "$QNUM" bypass 2>/dev/null
    # also catch inbound on prerouting (server->console arrives there)
    nft "add chain inet $TABLE pre { type filter hook prerouting priority mangle ; policy accept ; }" 2>/dev/null
    nft add rule inet "$TABLE" pre ip daddr "$HOST" udp sport "$GP" queue num "$QNUM" bypass 2>/dev/null
    return 0
}

case "$1" in
    on )
        deps || { echo "ERROR: python3-netfilterqueue unavailable. Can't run real pacer."; exit 1; }
        wire || { echo "nft wiring failed"; nft delete table inet "$TABLE" 2>/dev/null; exit 1; }
        echo "wired game flow -> NFQUEUE $QNUM. Launching pacer (Ctrl-C to stop & tear down)." >&2
        trap 'nft delete table inet "$TABLE" 2>/dev/null; echo; echo "torn down."; exit 0' INT TERM
        PHASE_HOST="$HOST" PHASE_PORT="$GP" PHASE_QNUM="$QNUM" python3 "$(dirname "$0")/phase-pacer.py"
        nft delete table inet "$TABLE" 2>/dev/null
        ;;
    off )
        nft delete table inet "$TABLE" 2>/dev/null && echo "torn down -> game flow no longer queued." || echo "(not active)"
        ;;
    * ) echo "usage: sh phase-pacer.sh [on|off]" ;;
esac 
